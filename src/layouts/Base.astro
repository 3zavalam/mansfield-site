---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, EMAIL, GITHUB_URL, LINKEDIN_URL } from '../consts';
import { NAV } from '../sections';
interface Props { title?: string; description?: string; type?: string }
const { title, description = SITE_DESCRIPTION, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · Mansfield` : `Mansfield · ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// The header is the four sections; the rest of the site is linked from the footer.
const nav = NAV;
const more: [string, string][] = [['About', '/about'], ['Now', '/now'], ['Work with me', '/work-with-me']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
  <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Mansfield" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
  <slot name="head" />
  <script is:inline>
    (function(){var t=localStorage.getItem('theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');})();
  </script>
</head>
{/* .v3 sets the whole site in Futura (see global.css). */}
<body class="v3 min-h-screen">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <header class="flex items-center justify-between gap-4 py-6 sm:py-8">
      <a href="/" class="serif text-lg leading-tight sm:text-xl">Mansfield<span class="text-accent dark:text-accent-dark">.</span></a>
      <div class="flex items-center gap-1 sm:gap-2">
        <nav class="hidden items-center gap-5 text-sm sm:flex">
          {nav.map(([l, h]) => <a href={h} class:list={['transition-colors hover:text-accent dark:hover:text-accent-dark', path.startsWith(h) ? 'text-ink dark:text-white font-medium' : 'text-stone-500 dark:text-stone-400']}>{l}</a>)}
        </nav>
        <button id="theme" aria-label="Toggle dark mode" class="rounded-full p-2 text-stone-500 hover:text-ink dark:text-stone-400 dark:hover:text-white">
          <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button id="menu" aria-label="Open menu" aria-expanded="false" class="rounded-full p-2 sm:hidden">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </header>
    <nav id="mobile-nav" class="hidden border-y border-stone-200 py-3 text-base sm:hidden dark:border-stone-800">
      {nav.map(([l, h]) => <a href={h} class="block py-2">{l}</a>)}
      {more.map(([l, h]) => <a href={h} class="block py-2 text-stone-500 dark:text-stone-400">{l}</a>)}
    </nav>
    <main class="pb-16 pt-6 sm:pt-10"><slot /></main>
    <footer class="flex flex-col gap-3 border-t border-stone-200 py-8 text-sm text-stone-500 sm:flex-row sm:justify-between dark:border-stone-800 dark:text-stone-400">
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        {more.map(([l, h]) => <a class="hover:text-ink dark:hover:text-white" href={h}>{l}</a>)}
      </div>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        <a class="hover:text-ink dark:hover:text-white" href={`mailto:${EMAIL}`}>Email</a>
        <a class="hover:text-ink dark:hover:text-white" href={GITHUB_URL}>GitHub</a>
        <a class="hover:text-ink dark:hover:text-white" href={LINKEDIN_URL}>LinkedIn</a>
        <a class="hover:text-ink dark:hover:text-white" href="/rss.xml">RSS</a>
        <span>© {new Date().getFullYear()} Mansfield</span>
      </div>
    </footer>
  </div>
  <script is:inline>
    document.getElementById('theme').onclick=function(){var d=document.documentElement.classList.toggle('dark');localStorage.setItem('theme',d?'dark':'light');};
    var m=document.getElementById('menu'),n=document.getElementById('mobile-nav');m.onclick=function(){var h=n.classList.toggle('hidden');m.setAttribute('aria-expanded',String(!h));};
  </script>
</body>
</html>
