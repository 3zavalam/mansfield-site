---
// The /iteratev2 hero: crystal objects rendered live in Three.js, with a day/night toggle.
// Views: home (Projects · Resources · Personal), projects (Business Analysis · Portfolio), resources (Museums · Photos · Podcasts · Books · Movies).
interface Props { view: 'home' | 'projects' | 'resources' }
const { view } = Astro.props;
const title = { home: 'Iterate v2', projects: 'Projects · Iterate v2', resources: 'Resources · Iterate v2' }[view];
---
<!doctype html>
<html lang="en" data-view={view}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#151515" />
  <script is:inline>
    // Pick the look before first paint: saved choice, else the system setting.
    (function () {
      var l; try { l = localStorage.getItem('iteratev2-look'); } catch (e) {}
      if (l !== 'day' && l !== 'night') l = matchMedia('(prefers-color-scheme: light)').matches ? 'day' : 'night';
      document.documentElement.dataset.look = l;
    })();
  </script>
</head>
<body>
  <canvas class="stage" role="img"></canvas>
  <span class="vignette" aria-hidden="true"></span>
  <nav class="names" aria-label="Sections"></nav>
  <span class="veil" aria-hidden="true"></span>
  <button type="button" class="back" aria-label="Back">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button type="button" class="look" aria-label="Switch to day">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z" /></svg>
  </button>
  <script>
    import { mountCrystals, type Look, type View } from '../iteratev2/scene';
    const root = document.documentElement;
    const canvas = document.querySelector<HTMLCanvasElement>('.stage')!;
    const lookBtn = document.querySelector<HTMLButtonElement>('.look')!, backBtn = document.querySelector<HTMLButtonElement>('.back')!;
    const PATHS: Record<View, string> = { home: '/iteratev2', projects: '/iteratev2/projects', resources: '/iteratev2/resources' };
    const TITLES: Record<View, string> = { home: 'Iterate v2', projects: 'Projects · Iterate v2', resources: 'Resources · Iterate v2' };
    const DESCRIBE: Record<View, string> = {
      home: 'Three soft crystal objects mounted on a wall: a soccer pitch with a ball in the centre, a closed book on the left, and a postcard with a cathedral in relief on the right.',
      projects: 'Two soft crystal objects mounted on a wall: a clipboard with a business analysis sheet (bar chart, trend line, donut chart) and an open laptop for the portfolio.',
      resources: 'Five soft crystal objects mounted on a wall: a museum facade, a disposable camera, a microphone, a book cover and a film reel.',
    };
    const look = () => (root.dataset.look === 'day' ? 'day' : 'night') as Look;
    const viewOf = (path: string): View => (path.includes('/resources') ? 'resources' : path.includes('/projects') ? 'projects' : 'home');
    const initial = viewOf(location.pathname);
    const describe = (v: View) => { canvas.setAttribute('aria-label', DESCRIBE[v]); document.title = TITLES[v]; };
    describe(initial);

    // Views and browser history: clicking the pitch or the book pushes its URL; back / Esc / browser back return home.
    let pushed = false;
    const scene = mountCrystals(canvas, {
      names: document.querySelector<HTMLElement>('.names')!,
      veil: document.querySelector<HTMLElement>('.veil')!,
      look: look(), view: initial,
      onNavigate: (v) => { history.pushState({ view: v }, '', PATHS[v]); pushed = true; describe(v); },
    });
    history.replaceState({ view: initial }, '');
    addEventListener('popstate', (e) => {
      const v = ((e.state && e.state.view) || viewOf(location.pathname)) as View;
      scene.go(v); describe(v);
    });
    const home = () => {
      if (root.dataset.view === 'home') return;
      if (pushed) { history.back(); return; }
      history.pushState({ view: 'home' }, '', PATHS.home);
      scene.go('home'); describe('home');
    };
    backBtn.addEventListener('click', home);
    addEventListener('keydown', (e) => { if (e.key === 'Escape') home(); });

    const syncLook = () => lookBtn.setAttribute('aria-label', look() === 'day' ? 'Switch to night' : 'Switch to day');
    syncLook();
    lookBtn.addEventListener('click', () => {
      const next: Look = look() === 'day' ? 'night' : 'day';
      root.dataset.look = next;
      try { localStorage.setItem('iteratev2-look', next); } catch (e) {}
      scene.setLook(next);
      syncLook();
    });
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #141414; --name: #a7a7a7; --name-hover: #e6e6e6; --shade: rgba(0, 0, 0, .55);
    --btn: rgba(255, 255, 255, .06); --btn-edge: rgba(255, 255, 255, .12); --icon: #cfcfcf;
  }
  :root[data-look="day"] {
    --bg: #d6d2cb; --name: #5f5b56; --name-hover: #1f1d1b; --shade: rgba(60, 50, 40, .2);
    --btn: rgba(255, 255, 255, .55); --btn-edge: rgba(0, 0, 0, .08); --icon: #4a4743;
  }
  html, body { margin: 0; height: 100%; overflow: hidden; }
  body { background: var(--bg); transition: background-color .8s ease; }
  .stage {
    position: fixed; inset: 0; width: 100%; height: 100%; display: block;
    opacity: 0; transition: opacity .35s ease;
  }
  .stage.ready { opacity: 1; }
  /* Soft studio falloff toward the edges. */
  .vignette {
    position: fixed; inset: 0; pointer-events: none;
    background: radial-gradient(120% 95% at 50% 45%, transparent 45%, var(--shade) 100%);
  }
  /* Cross-fade layer between views; its opacity is driven by the scene. */
  .veil { position: fixed; inset: 0; pointer-events: none; background: var(--bg); opacity: 0; }

  /* Names under each object; built and positioned by the scene every frame. */
  .name {
    position: fixed; left: 0; top: 0; white-space: nowrap; pointer-events: none;
    font: 300 12px/1 'Helvetica Neue', Helvetica, system-ui, -apple-system, sans-serif;
    letter-spacing: .32em; text-transform: uppercase; color: var(--name); text-decoration: none;
    opacity: 0; transition: opacity .35s ease .1s, color .3s ease;
  }
  .name[hidden] { display: none; }
  a.name { pointer-events: auto; padding: 8px 0; margin-top: -8px; }
  a.name:hover, a.name:focus-visible { color: var(--name-hover); outline: none; }
  .stage.ready ~ .names .name { opacity: 1; }

  /* Round buttons: day / night (top right) and back (top left, only in a sub-view). */
  .look, .back {
    position: fixed; top: 20px; z-index: 2;
    display: grid; place-items: center; width: 40px; height: 40px; padding: 0;
    border: 1px solid var(--btn-edge); border-radius: 50%; background: var(--btn); color: var(--icon);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    cursor: pointer; transition: background-color .8s ease, color .8s ease, border-color .8s ease, transform .2s ease, opacity .35s ease;
  }
  .look { right: 20px; }
  .back { left: 20px; }
  :root[data-view="home"] .back { opacity: 0; pointer-events: none; }
  .look:hover, .back:hover { transform: scale(1.06); }
  .look:active, .back:active { transform: scale(.95); }
  .look:focus-visible, .back:focus-visible { outline: 2px solid var(--icon); outline-offset: 3px; }
  .look svg, .back svg { grid-area: 1 / 1; width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: opacity .3s ease, transform .4s ease; }
  /* Shows the look you'd switch to: sun at night, moon by day. */
  :root[data-look="day"] .sun, :root:not([data-look="day"]) .moon { opacity: 0; transform: rotate(-60deg) scale(.6); }
  @media (prefers-reduced-motion: reduce) { .stage, body, .name, .look, .back, .look svg { transition: none; } }
</style>
