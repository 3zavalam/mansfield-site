---
// /iteratev3/projects: every club I've worked for and everything I've built, on one spinning wheel.
// Scroll or drag to spin, pick one to read about it. Other tries: ./shots (a shot map) and ./dial.
import Base from '../../../layouts/Base.astro';
import ProjectSheet from '../../../components/ProjectSheet.astro';
import { NAV, HOME } from '../../../iteratev3';
import { items, src } from '../../../iteratev3-projects';
const ring = [...items, ...items]; // twice round, so the wheel looks full
---
<Base title="Projects" nav={NAV} home={HOME} cta={false} footer={false} theme="v3">
  <section class="wheel relative -mx-2 select-none" aria-label="Clubs and builds">
    <div class="pointer-events-none absolute inset-x-2 top-0 z-10 flex items-start justify-between gap-4">
      <p class="eyebrow pt-1.5">Projects</p>
      <div class="pointer-events-auto flex gap-1.5" role="group" aria-label="Show">
        {['All', 'Club', 'Build'].map((f, i) => (
          <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'} class="filter rounded-full border border-stone-300 px-3.5 py-1 text-[13px] transition dark:border-stone-700">{f === 'All' ? 'All' : f + 's'}</button>
        ))}
      </div>
    </div>

    <div class="stage relative mx-auto touch-none">
      {ring.map((it, n) => (
        <button type="button" class="tile absolute left-0 top-0" data-id={it.id} data-kind={it.kind} tabindex={n < items.length ? 0 : -1} aria-hidden={n < items.length ? undefined : 'true'} aria-label={`${it.t}: ${it.s}`}>
          {it.img
            ? <img src={src(it.img)} alt="" loading="lazy" draggable="false" class="h-full w-full object-cover object-top" />
            : <span class:list={['grid h-full w-full place-items-center', it.dark ? 'bg-stone-900' : 'bg-white']}>
                {it.logo ? <img src={src(it.logo)} alt="" draggable="false" class="h-1/2 w-1/2 object-contain" /> : <span class="text-[clamp(8px,1.1vw,12px)] font-bold tracking-wide text-ink">{it.t}</span>}
              </span>}
        </button>
      ))}
      {/* The middle of the wheel names whatever you point at. */}
      <div class="center pointer-events-none absolute inset-0 grid place-items-center text-center">
        <div class="max-w-[46%]">
          <p class="hover-kind mono text-[11px] uppercase tracking-[0.2em] text-stone-500 dark:text-stone-400">Clubs &amp; builds</p>
          <p class="hover-title mt-2 text-xl leading-snug sm:text-3xl"><span class="font-semibold">11 things</span> from 2024 to now</p>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-2 bottom-0 flex justify-between text-[12px] uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">
      <span>Scroll or drag to spin</span>
      <span class="count mono tracking-normal">01 — {String(items.length).padStart(2, '0')}</span>
    </div>
  </section>

  <ProjectSheet />
</Base>

<style>
  .wheel { padding: 3rem 0 2rem; min-height: calc(100svh - 10.5rem); display: flex; flex-direction: column; justify-content: center; }
  .stage { width: min(100%, calc(100svh - 15.5rem)); aspect-ratio: 1; min-width: 300px; max-width: 100%; }
  .tile {
    overflow: hidden; border-radius: 4px; cursor: pointer; background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / .06), 0 6px 16px -8px rgb(0 0 0 / .25);
    transition: opacity .3s ease, filter .3s ease, scale .25s ease;
  }
  .tile:hover, .tile:focus-visible { scale: 1.12; z-index: 2; outline: none; }
  .tile:focus-visible { box-shadow: 0 0 0 2px var(--color-accent); }
  .tile.dim { opacity: .15; filter: grayscale(1); pointer-events: none; }
  .filter[aria-pressed="true"] { background: var(--color-ink, #1c1917); border-color: transparent; color: #fff; }
  :global(.dark) .filter[aria-pressed="true"] { background: #f5f5f4; color: #1c1917; }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>

<script>
  // Lays the tiles out on a circle every frame. Scroll, drag or swipe spins it; it drifts slowly when idle.
  const stage = document.querySelector<HTMLElement>('.stage')!;
  const tiles = [...stage.querySelectorAll<HTMLButtonElement>('.tile')];
  const kindEl = document.querySelector('.hover-kind')!, titleEl = document.querySelector('.hover-title')!;
  const idle = [kindEl.innerHTML, titleEl.innerHTML];
  const countEl = document.querySelector('.count')!;
  const unique = tiles.length / 2;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let angle = -Math.PI / 2, vel = 0, size = 0, tile = 0;

  const measure = () => {
    size = stage.clientWidth;
    tile = Math.round(size * .115);
    tiles.forEach((t) => { t.style.width = `${tile}px`; t.style.height = `${Math.round(tile * 1.3)}px`; });
  };
  const place = () => {
    const r = size / 2 - tile * .75, c = size / 2, step = (Math.PI * 2) / tiles.length;
    let top = 0, best = Infinity;
    tiles.forEach((t, i) => {
      const a = angle + i * step;
      t.style.translate = `${c + Math.cos(a) * r - tile / 2}px ${c + Math.sin(a) * r - tile * .65}px`;
      const d = Math.abs(Math.atan2(Math.sin(a + Math.PI / 2), Math.cos(a + Math.PI / 2)));
      if (d < best) { best = d; top = i % unique; }
    });
    countEl.textContent = `${String(top + 1).padStart(2, '0')} — ${String(unique).padStart(2, '0')}`;
  };
  let dragging = false, hovering = false;
  const frame = () => {
    if (!dragging) { angle += vel + (still || hovering ? 0 : .0012); vel *= .94; }
    place();
    requestAnimationFrame(frame);
  };
  measure(); place(); requestAnimationFrame(frame);
  new ResizeObserver(measure).observe(stage);

  stage.addEventListener('wheel', (e) => { e.preventDefault(); vel += (e.deltaY + e.deltaX) * .00025; }, { passive: false });

  // Drag spins it around the centre; a drag of more than a few pixels doesn't count as a click.
  let last = 0, moved = 0;
  const at = (e: PointerEvent) => { const b = stage.getBoundingClientRect(); return Math.atan2(e.clientY - b.top - b.height / 2, e.clientX - b.left - b.width / 2); };
  stage.addEventListener('pointerdown', (e) => { dragging = true; moved = 0; last = at(e); vel = 0; });
  addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const a = at(e); let d = a - last; if (d > Math.PI) d -= Math.PI * 2; if (d < -Math.PI) d += Math.PI * 2;
    angle += d; vel = d * .5; last = a; moved += Math.abs(e.movementX) + Math.abs(e.movementY);
  });
  addEventListener('pointerup', () => { dragging = false; });

  // Hover names it in the middle and stops the drift, so it's easy to click.
  tiles.forEach((t) => {
    const show = () => { const a = t.getAttribute('aria-label')!.split(': '); kindEl.textContent = t.dataset.kind!; titleEl.innerHTML = `<span class="font-semibold">${a[0]}</span>`; };
    t.addEventListener('pointerenter', () => { hovering = true; show(); }); t.addEventListener('focus', show);
    t.addEventListener('pointerleave', () => { hovering = false; kindEl.innerHTML = idle[0]; titleEl.innerHTML = idle[1]; });
  });

  // Click opens the pop-up (ProjectSheet).
  tiles.forEach((t) => t.addEventListener('click', () => {
    if (moved > 6) return;
    document.dispatchEvent(new CustomEvent('sheet:open', { detail: t.dataset.id }));
  }));

  // Filters dim the other kind.
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filters.forEach((f) => f.addEventListener('click', () => {
    filters.forEach((o) => o.setAttribute('aria-pressed', String(o === f)));
    tiles.forEach((t) => t.classList.toggle('dim', f.dataset.filter !== 'All' && t.dataset.kind !== f.dataset.filter));
  }));
</script>
