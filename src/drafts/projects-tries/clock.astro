---
// /iteratev3/projects/clock: a mechanical clock. Projects sit at 1–6 o'clock and the minute hand points
// at the one you pick; clubs (experience) sit at 7–11 and the hour hand points at those. The second hand
// ticks with real time, and the gears in the window tick with it and spin when a hand travels.
import Base from '../../../layouts/Base.astro';
import ProjectSheet from '../../../components/ProjectSheet.astro';
import { NAV, HOME } from '../../../iteratev3';
import { items, src, type Item } from '../../../iteratev3-projects';
// Names short enough to fit between two hours on the bezel.
const SHORT: Record<string, string> = { 'winner-way': 'Winner Way', xg: 'xG model', match: 'Post-match', web: 'Streamlit app', reservas: 'Reservaciones', superstore: 'Superstore', leon: 'Club León', mitacs: 'INRS', piquero: 'Piquero', riansa: 'RIANSA', udlap: 'UDLAP' };
const builds = items.filter((i) => i.kind === 'Build');
const clubs = items.filter((i) => i.kind === 'Club');
// Hour 1–6 for builds, 7–11 for clubs; angle in degrees clockwise from 12.
const marks = [...builds.map((it, i) => ({ it, h: i + 1 })), ...clubs.map((it, i) => ({ it, h: i + 7 }))].map((m) => ({ ...m, a: m.h * 30 }));
// Text along the bezel: the top path runs clockwise from 6 o'clock, the bottom one anticlockwise from 12,
// so every name reads upright. Both keep the text in the band between r=148 and r=158.
const TOP = 148, BOT = 158;
const bottom = (a: number) => a > 90 && a < 270;
const offset = (a: number) => `${((bottom(a) ? 360 - a : (a + 180) % 360) / 360) * 100}%`;
const circle = (r: number, cw: boolean) => cw ? `M0 ${r}A${r} ${r} 0 1 1 0 ${-r}A${r} ${r} 0 1 1 0 ${r}` : `M0 ${-r}A${r} ${r} 0 1 0 0 ${r}A${r} ${r} 0 1 0 0 ${-r}`;
// A gear outline: n trapezoid teeth around radius r.
const gear = (n: number, r: number, d = 4) => {
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    const t = (i / n) * Math.PI * 2, s = Math.PI / n;
    for (const [aa, rr] of [[t - s * .5, r - d / 2], [t - s * .25, r + d / 2], [t + s * .25, r + d / 2], [t + s * .5, r - d / 2]] as const)
      pts.push(`${(Math.cos(aa) * rr).toFixed(2)},${(Math.sin(aa) * rr).toFixed(2)}`);
  }
  return `M${pts.join('L')}Z`;
};
const G1 = { n: 16, r: 30, x: -14, y: 74 };
const G2 = { n: 10, r: 19, x: -14 + 49 * Math.cos(-.45), y: 74 + 49 * Math.sin(-.45) };
const G3 = { n: 8, r: 15, x: -14 + 45 * Math.cos(2.1), y: 74 + 45 * Math.sin(2.1) };
const face = 'fill-white dark:fill-stone-900';
const ink = 'fill-ink dark:fill-stone-100';
---
<Base title="Projects" nav={NAV} home={HOME} cta={false} footer={false} theme="v3">
  <div class="clock-page relative left-1/2 grid w-screen max-w-6xl -translate-x-1/2 items-center gap-y-4 px-4 sm:px-6 lg:grid-cols-[1fr_auto_1fr] lg:gap-x-10">
    {/* Experience (hour hand) on the left, Projects (minute hand) on the right; on small screens both sit under the clock. */}
    {[['Experience', 'Hour hand', clubs, 'hour'], ['Projects', 'Minute hand', builds, 'minute']].map(([label, hand, list, key], k) => (
      <aside class:list={['panel', k === 0 ? 'order-2 lg:order-1 lg:text-right' : 'order-3']} data-hand={key as string}>
        <p class="eyebrow">{label as string} <span class="mono hidden normal-case tracking-normal text-stone-400 sm:inline dark:text-stone-500">· {hand as string}</span></p>
        {(list as Item[]).map((it, i) => (
          <div data-detail={it.id} hidden={i !== 0} class="mt-3">
            <p class="mono text-[11px] uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">{it.when}</p>
            <p class="mt-1 text-lg font-semibold leading-snug sm:text-xl">{it.t}</p>
            <p class="text-[15px] leading-snug text-stone-500 dark:text-stone-400">{it.s}</p>
            <button type="button" class:list={['open group mt-3 inline-flex items-center gap-3', k === 0 && 'lg:flex-row-reverse']} data-id={it.id}>
              <span class:list={['grid h-11 w-16 shrink-0 place-items-center overflow-hidden rounded border border-stone-200 dark:border-stone-700', it.dark ? 'bg-stone-900' : 'bg-white']}>
                {it.img ? <img src={src(it.img)} alt="" loading="lazy" class="h-full w-full object-cover object-top" />
                  : it.logo ? <img src={src(it.logo)} alt="" class="h-7 w-7 object-contain" /> : <span class="text-[9px] font-bold text-ink">{it.t}</span>}
              </span>
              <span class="whitespace-nowrap text-sm font-medium transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">Read more</span>
            </button>
          </div>
        ))}
      </aside>
    ))}

    <div class="clock order-1 relative mx-auto aspect-square lg:order-2" tabindex="0" aria-label="Clock: scroll or use the arrow keys to move the hands, or pick a name on the dial">
      <svg viewBox="-200 -200 400 400" class="h-full w-full overflow-visible" aria-hidden="true">
        <defs>
          <path id="bz-top" d={circle(TOP, true)} />
          <path id="bz-bot" d={circle(BOT, false)} />
          <clipPath id="win"><circle cx="0" cy="74" r="46" /></clipPath>
        </defs>
        {/* Case and bezel */}
        <circle r="196" class="fill-stone-200 dark:fill-stone-800" />
        <circle r="190" class={face} />
        <circle r="190" fill="none" class="stroke-stone-300 dark:stroke-stone-700" />
        <circle r="168" fill="none" class="stroke-stone-200 dark:stroke-stone-800" />
        {/* Minute and hour ticks */}
        {Array.from({ length: 60 }, (_, i) => (
          <line y1={i % 5 ? -138 : -126} y2="-142" transform={`rotate(${i * 6})`} stroke-width={i % 5 ? .8 : 2.2} class={i % 5 ? 'stroke-stone-300 dark:stroke-stone-600' : 'stroke-stone-500 dark:stroke-stone-400'} />
        ))}
        <path d="M0 -183 L-5 -173 L5 -173 Z" class="fill-accent dark:fill-accent-dark" />
        {/* Names on the bezel */}
        {marks.map((m) => (
          <text class="bz fill-stone-400 text-[11px] dark:fill-stone-500" data-id={m.it.id} text-anchor="middle" letter-spacing=".4">
            <textPath href={bottom(m.a) ? '#bz-bot' : '#bz-top'} startOffset={offset(m.a)}>{SHORT[m.it.id] ?? m.it.t}</textPath>
          </text>
        ))}
        {/* Maker's mark */}
        <text y="-72" text-anchor="middle" class="fill-ink text-[15px] font-semibold dark:fill-stone-100" letter-spacing="3">MANSFIELD</text>
        <text y="-56" text-anchor="middle" class="fill-stone-400 text-[7.5px] dark:fill-stone-500" letter-spacing="2">EST. 2024 · MÉXICO</text>
        {/* Window onto the movement */}
        <circle cx="0" cy="74" r="47.5" class="fill-stone-100 stroke-stone-300 dark:fill-stone-950 dark:stroke-stone-700" />
        <g clip-path="url(#win)" class="stroke-stone-500 dark:stroke-stone-400" stroke-width=".9" stroke-linejoin="round">
          {[G1, G2, G3].map((g, i) => (
            <g transform={`translate(${g.x.toFixed(2)} ${g.y.toFixed(2)})`}>
              <g class="gear" data-g={i}>
                <path d={gear(g.n, g.r)} class={face} />
                <circle r={g.r * .62} fill="none" />
                {[0, 1, 2, 3, 4].slice(0, i === 0 ? 5 : 3).map((s, _, arr) => <line x1="0" y1="0" x2={(Math.cos((s / arr.length) * Math.PI * 2) * g.r * .62).toFixed(2)} y2={(Math.sin((s / arr.length) * Math.PI * 2) * g.r * .62).toFixed(2)} />)}
                <circle r="3" class="fill-accent stroke-none dark:fill-accent-dark" />
              </g>
            </g>
          ))}
        </g>
        <circle cx="0" cy="74" r="46" fill="none" class="stroke-stone-400 dark:stroke-stone-600" stroke-width="1.5" />
        {/* Hands: hour, minute, second */}
        <g class="hand-hour"><path d="M-4.5 16 L-2.6 -70 L0 -86 L2.6 -70 L4.5 16 Z" class={ink} /><circle cy="-60" r="6.5" class={face} /><circle cy="-60" r="6.5" fill="none" class="stroke-ink dark:stroke-stone-100" stroke-width="2.2" /></g>
        <g class="hand-minute"><path d="M-3.2 20 L-1.6 -116 L0 -130 L1.6 -116 L3.2 20 Z" class={ink} /><circle cy="-102" r="5" class={face} /><circle cy="-102" r="5" fill="none" class="stroke-ink dark:stroke-stone-100" stroke-width="1.8" /></g>
        <g class="hand-second"><line y1="26" y2="-140" stroke-width="1.2" class="stroke-accent dark:stroke-accent-dark" /><circle cy="20" r="4" class="fill-accent dark:fill-accent-dark" /></g>
        <circle r="7" class={ink} /><circle r="2.4" class="fill-accent dark:fill-accent-dark" />
      </svg>
      {/* Hit areas over each name */}
      {marks.map((m) => (
        <button type="button" class="pick absolute h-10 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full" data-id={m.it.id} data-h={m.h} aria-label={`${m.it.kind === 'Club' ? 'Experience' : 'Project'}: ${m.it.t}`}
          style={`left:${50 + Math.sin((m.a * Math.PI) / 180) * 38.25}%;top:${50 - Math.cos((m.a * Math.PI) / 180) * 38.25}%`} />
      ))}
    </div>
  </div>
  <ProjectSheet />
</Base>

<style>
  .clock-page { min-height: calc(100svh - 10.5rem); }
  .clock { width: min(calc(100vw - 2rem), calc(100svh - 12rem), 580px); outline: none; }
  @media (max-width: 1023px) {
    .clock-page { grid-template-columns: 1fr 1fr; column-gap: 1.25rem; align-content: center; }
    .clock { grid-column: 1 / -1; width: min(calc(100vw - 2rem), calc(100svh - 22rem), 520px); min-width: 260px; }
  }
  .bz { font-family: inherit; transition: fill .3s ease; }
  .bz.on { fill: var(--color-ink); font-weight: 600; }
  :global(.dark) .bz.on { fill: #f5f5f4; }
  .pick:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
  .panel [data-detail] { animation: in .35s ease; }
  @keyframes in { from { opacity: 0; transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) { .panel [data-detail] { animation: none; } }
</style>

<script>
  // Each hand is a damped spring toward its target angle, so it lands with a small mechanical overshoot.
  // The second hand follows real seconds; the gears tick with it and spin while a hand is travelling.
  const svg = document.querySelector<SVGSVGElement>('.clock svg')!;
  const clock = document.querySelector<HTMLElement>('.clock')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Hand = { el: SVGGElement; a: number; v: number; to: number };
  const hand = (sel: string, to: number): Hand => ({ el: svg.querySelector<SVGGElement>(sel)!, a: to, v: 0, to });
  const picks = [...document.querySelectorAll<HTMLButtonElement>('.pick')];
  const hours = picks.map((p) => +p.dataset.h!); // 1..11
  const firstOf = (club: boolean) => picks.find((p) => (+p.dataset.h! >= 7) === club)!;
  const H = hand('.hand-hour', +firstOf(true).dataset.h! * 30);
  const M = hand('.hand-minute', +firstOf(false).dataset.h! * 30);
  const S = hand('.hand-second', new Date().getSeconds() * 6);
  const gears = [...svg.querySelectorAll<SVGGElement>('.gear')];
  const RATIO = [1, -16 / 10, -16 / 8]; // meshing gears turn the other way, faster when smaller
  let gearA = 0, gearTo = 0, gearV = 0;
  let current = +firstOf(false).dataset.h!; // the hour the scroll/arrow keys move from

  // Turning a hand to a new hour, the shortest way round.
  const turn = (h: Hand, deg: number) => {
    let d = ((deg - h.to) % 360 + 540) % 360 - 180;
    h.to += d; gearTo += Math.abs(d) * 1.5;
    if (still) h.a = h.to;
  };
  const select = (id: string) => {
    const p = picks.find((x) => x.dataset.id === id)!, h = +p.dataset.h!, club = h >= 7;
    current = h;
    turn(club ? H : M, h * 30);
    svg.querySelectorAll('.bz').forEach((t) => {
      const ph = +picks.find((x) => x.dataset.id === (t as SVGElement).dataset.id)!.dataset.h!;
      if ((ph >= 7) === club) t.classList.toggle('on', t.getAttribute('data-id') === id);
    });
    const panel = document.querySelector<HTMLElement>(`.panel[data-hand="${club ? 'hour' : 'minute'}"]`)!;
    panel.querySelectorAll<HTMLElement>('[data-detail]').forEach((d) => (d.hidden = d.dataset.detail !== id));
  };
  // Start with the first of each lit up.
  select(firstOf(true).dataset.id!); select(firstOf(false).dataset.id!);
  H.a = H.to; M.a = M.to; gearA = gearTo = 0;

  const spring = (h: Hand, k = .09, damp = .74) => { h.v = (h.v + (h.to - h.a) * k) * damp; h.a += h.v; h.el.setAttribute('transform', `rotate(${h.a.toFixed(2)})`); };
  let lastSec = new Date().getSeconds();
  const frame = () => {
    const sec = new Date().getSeconds();
    if (sec !== lastSec) { S.to += ((sec - lastSec + 60) % 60) * 6; lastSec = sec; gearTo += 8; }
    if (still) { S.a = S.to; gearA = gearTo; }
    spring(H); spring(M); spring(S, .35, .55);
    gearV = (gearV + (gearTo - gearA) * .2) * .6; gearA += gearV;
    gears.forEach((g, i) => g.setAttribute('transform', `rotate(${(gearA * RATIO[i] + (i ? 9 : 0)).toFixed(2)})`));
    requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);

  // Picking a name moves its hand; scroll and arrow keys step round the hours one at a time.
  picks.forEach((p) => p.addEventListener('click', () => select(p.dataset.id!)));
  const step = (d: number) => {
    const i = hours.indexOf(current);
    select(picks[(i + d + picks.length) % picks.length].dataset.id!);
  };
  let acc = 0, lock = 0;
  clock.addEventListener('wheel', (e) => {
    e.preventDefault();
    const now = performance.now();
    if (now < lock) return;
    acc += e.deltaY + e.deltaX;
    if (Math.abs(acc) > 40) { step(Math.sign(acc)); acc = 0; lock = now + 320; }
  }, { passive: false });
  clock.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
  });
  document.querySelectorAll<HTMLButtonElement>('.panel .open').forEach((b) => b.addEventListener('click', () => document.dispatchEvent(new CustomEvent('sheet:open', { detail: b.dataset.id }))));
</script>
