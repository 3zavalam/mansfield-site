---
import Base from '../layouts/Base.astro';
import { EMAIL, UPWORK_URL } from '../consts';
const services = [
  { t: 'Power BI & data dashboards', d: 'Turn spreadsheets and exports into a clean data model and a dashboard your team actually opens. Clear KPIs, sensible DAX, documented so you can maintain it.', f: 'Small teams with data in Excel' },
  { t: 'Python automation & scraping', d: 'Scripts that clean messy files, build your reports, or collect data from the web on a schedule, so the manual morning routine becomes one command.', f: 'Anyone doing repetitive data work' },
  { t: 'Finish your AI-built MVP', d: "You built 80% of your product with Claude, Lovable, Bolt or Cursor, and now it's stuck. I'll do the last 20%: deploy it, fix the bugs, set up authentication, payments and the database, so real users can use it.", f: 'Non-technical founders' },
  { t: 'Web apps', d: 'Small full-stack apps with React, Flask or FastAPI and Supabase, like a booking system with an admin dashboard, a customer app and a door-staff view.', f: 'Small businesses and side projects' },
  { t: 'AI chatbots & automations', d: 'A chatbot that answers your FAQs from your own content, or AI steps wired into the tools you already use. Scoped to what saves you time, not hype.', f: 'Events, services, support teams' },
  { t: 'Sports & football analysis', d: 'Scouting tools, xG models, match reports and shot maps from public or club data. The kind of work I enjoy most.', f: 'Clubs, scouts, analysts, media' },
];
---
<Base title="Work with me" description="Data and dashboards, Python automation, finishing AI-built MVPs, web apps, AI chatbots and sports analysis.">
  <p class="eyebrow">Work with me</p>
  <h1 class="serif mt-4 text-4xl leading-tight tracking-tight sm:text-5xl">Work with me</h1>
  <div class="mt-6 max-w-2xl space-y-4 text-[17px] leading-relaxed text-stone-700 dark:text-stone-300">
    <p>I like doing the data stuff and I'm more experienced there, but helping people get the last 20% of their MVPs, I'd love that.</p>
  </div>
  <section class="mt-12">
    <h2 class="eyebrow">What I can help with</h2>
    <ol class="mt-4 divide-y divide-stone-200 border-y border-stone-200 dark:divide-stone-800 dark:border-stone-800">
      {services.map((s, i) => (
        <li class="grid gap-3 py-7 sm:grid-cols-[3rem_1fr]">
          <span class="serif text-lg text-stone-400 dark:text-stone-600">{String(i + 1).padStart(2, '0')}</span>
          <div><h3 class="serif text-2xl leading-snug">{s.t}</h3><p class="mt-3 leading-relaxed text-stone-600 dark:text-stone-400">{s.d}</p><p class="mt-3 text-xs uppercase tracking-wider text-stone-500">For: {s.f}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14">
    <h2 class="eyebrow">How it works</h2>
    <ol class="mt-5 grid gap-6 sm:grid-cols-3">
      <li><p class="serif text-lg">1. Tell me the problem</p><p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">Email me what you have and what's blocking you. Links and screenshots help.</p></li>
      <li><p class="serif text-lg">2. Get a fixed scope</p><p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">I reply with what I'd do, a price and a timeline before any work starts.</p></li>
      <li><p class="serif text-lg">3. Ship it</p><p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">Regular updates, then a handover with docs so you're not dependent on me.</p></li>
    </ol>
  </section>
  <section class="mt-16 border-t border-stone-200 pt-10 dark:border-stone-800">
    <h2 class="serif text-3xl">Let's talk</h2>
    <p class="mt-3 text-stone-600 dark:text-stone-400">The fastest way is email. You can also hire me through Upwork.</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href={`mailto:${EMAIL}`} class="rounded-full bg-ink px-5 py-3 text-center text-sm font-medium text-paper transition hover:bg-accent dark:bg-stone-100 dark:text-night">{EMAIL}</a>
      <a href={UPWORK_URL} class="rounded-full border border-stone-300 px-5 py-3 text-center text-sm font-medium transition hover:border-ink dark:border-stone-700 dark:hover:border-stone-300">Upwork →</a>
    </div>
  </section>
</Base>
