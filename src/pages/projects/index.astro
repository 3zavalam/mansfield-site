---
// /projects: a jigsaw that builds a small city seen from above. Each piece is a block
// for a job or a project (campus, factory, pool, stadium, tennis courts…). The board shows it as a blueprint; a placed piece is in colour. Drag a piece
// onto the board (it snaps when close) or just tap it and it finds its spot. Tap a placed piece to read about it.
//
// The street is drawn once (#street). The blueprint and every piece are use-copies of it; the copies differ
// only in CSS variables (colours inherit into a use), and each piece is clipped to its jigsaw shape.
import Base from '../../layouts/Base.astro';
import ProjectSheet from '../../components/ProjectSheet.astro';
import { items } from '../../projects';

const C = 300, COLS = 4, ROWS = 3;
// Which building sits in which cell, row by row. 'home' is the starting piece, already in place.
const grid = [['udlap', 'riansa', 'piquero', 'mitacs'], ['leon', 'winner-way', 'home', 'xg'], ['match', 'web', 'reservas', 'superstore']];
const byId = Object.fromEntries(items.map((i) => [i.id, i]));

// Jigsaw edges. h[r][c]: the edge above row r in column c; v[r][c]: the edge left of column c in row r.
// ±1 is which way the knob points; 0 is the board's straight border.
const h = Array.from({ length: ROWS + 1 }, (_, r) => Array.from({ length: COLS }, (_, c) => (r === 0 || r === ROWS ? 0 : (r + c) % 2 ? 1 : -1)));
const v = Array.from({ length: ROWS }, (_, r) => Array.from({ length: COLS + 1 }, (_, c) => (c === 0 || c === COLS ? 0 : (r * 3 + c) % 2 ? 1 : -1)));
const K = 0.82; // knob size
const knob = [[.36, 0], [.40, 0, .42, .04, .40, .10], [.36, .20, .42, .26, .50, .26], [.58, .26, .64, .20, .60, .10], [.58, .04, .60, 0, .64, 0]];
const edge = (ax: number, ay: number, bx: number, by: number, nx: number, ny: number, k: number) => {
  if (!k) return `L${bx} ${by}`;
  const P = (u: number, w: number) => `${(ax + (bx - ax) * u + nx * w * C * K * k).toFixed(1)} ${(ay + (by - ay) * u + ny * w * C * K * k).toFixed(1)}`;
  const [l, ...cs] = knob;
  return `L${P(l[0], l[1])}` + cs.map((q) => `C${P(q[0], q[1])} ${P(q[2], q[3])} ${P(q[4], q[5])}`).join('') + `L${bx} ${by}`;
};
const piecePath = (r: number, c: number) => {
  const x = c * C, y = r * C;
  return `M${x} ${y}` + edge(x, y, x + C, y, 0, 1, h[r][c]) + edge(x + C, y, x + C, y + C, 1, 0, v[r][c + 1]) + edge(x + C, y + C, x, y + C, 0, 1, h[r + 1][c]) + edge(x, y + C, x, y, 1, 0, v[r][c]) + 'Z';
};
const pieces = grid.flatMap((row, r) => row.map((id, c) => ({ id, r, c, d: piecePath(r, c) })));

// The back of each piece (shown when it's flipped): word-wrapped lines for SVG text.
const wrap = (text: string, max: number) => {
  const lines: string[] = [''];
  for (const w of text.split(' ')) {
    const cur = lines[lines.length - 1];
    if (cur && (cur + ' ' + w).length > max) lines.push(w);
    else lines[lines.length - 1] = cur ? cur + ' ' + w : w;
  }
  return lines;
};
const back = (id: string) => {
  const it = byId[id];
  if (!it) return { kind: 'EST. 2024', title: wrap('Mansfield St.', 14), sub: wrap('The street behind my internship in Montreal, and where this site got its name.', 22).slice(0, 4), more: false };
  return { kind: `${it.kind === 'Club' ? 'EXPERIENCE' : 'PROJECT'} · ${it.when.toUpperCase()}`, title: wrap(it.t, 14).slice(0, 2), sub: wrap(it.s, 22).slice(0, 3), more: true };
};

// Inline styles (not classes) so colours resolve inside each use copy.
const S = (fill: string, w = 2) => `fill:var(--${fill});stroke:var(--ln);stroke-width:${w}`;
const L = (w = 2, col = 'ln') => `fill:none;stroke:var(--${col});stroke-width:${w}`;
const T = (fill: string, size: number, extra = '') => `fill:var(--${fill});font-size:${size}px;font-weight:700;${extra}`;
// A scalloped awning edge: n bumps from x1 back to x0.
const scallop = (x0: number, x1: number, y: number, n: number) => {
  const w = (x1 - x0) / n;
  const bumps = Array.from({ length: n }, () => `q${-w / 2} 10 ${-w} 0`).join('');
  return `M${x0} ${y - 12}H${x1}V${y}${bumps}Z`;
};
---
<Base title="Projects">
  {/* Header in the site's text column; the puzzle below gets the full window width. */}
  <div class="flex items-center justify-between gap-4">
    <p class="eyebrow">Projects <span class="mono hidden normal-case tracking-normal text-stone-400 sm:inline dark:text-stone-500">· a city of things I've done</span></p>
    <button type="button" class="mode">Try it out</button>
  </div>
  <div class="puzzle-page relative left-1/2 flex w-screen -translate-x-1/2 flex-col items-center px-3 sm:px-6">
    <div class="stage mt-3">
      <svg class="done h-full w-full touch-none select-none overflow-visible" viewBox="-20 -20 1240 940" aria-label="A jigsaw of a small city; each block is a job or a project">
        <defs>
          <g id="street">
            {/* A small city from above. Roads run along every cell edge; each cell is one block. */}
            <rect x="0" y="0" width="1200" height="900" style="fill:var(--road)" />
            <path d="M300 0V900M600 0V900M900 0V900M0 300H1200M0 600H1200" style="fill:none;stroke:var(--paint);stroke-width:2.5;stroke-dasharray:16 14" />
            {[300, 600, 900].flatMap((x) => [300, 600].map((y) => (
              <path d={`M${x - 20} ${y - 30}h40M${x - 20} ${y - 35}h40M${x - 20} ${y + 30}h40M${x - 20} ${y + 35}h40M${x - 30} ${y - 20}v40M${x - 35} ${y - 20}v40M${x + 30} ${y - 20}v40M${x + 35} ${y - 20}v40`} style="fill:none;stroke:var(--paint);stroke-width:2.5" />
            )))}
            {[0, 1, 2].flatMap((r) => [0, 1, 2, 3].map((c) => <rect x={c * C + 22} y={r * C + 22} width="256" height="256" rx="12" style={S('walk', 1.5)} />))}

            {/* UDLAP: campus around a quad */}
            <g transform="translate(0 0)">
              <rect x="32" y="32" width="236" height="236" rx="6" style="fill:var(--green)" />
              <path d="M150 92V262M92 178H208" style="fill:none;stroke:var(--walk);stroke-width:10" />
              <rect x="40" y="40" width="220" height="52" style={S('w2')} /><path d="M40 66H260" style={L(1)} />
              <rect x="40" y="92" width="52" height="128" style={S('w2')} /><path d="M66 92V220" style={L(1)} />
              <rect x="208" y="92" width="52" height="128" style={S('w2')} /><path d="M234 92V220" style={L(1)} />
              <circle cx="150" cy="178" r="17" style={S('win')} /><circle cx="150" cy="178" r="5" style={S('paper', 1)} />
              {[[118, 128], [182, 128], [118, 232], [182, 232], [250, 250]].map(([x, y]) => <circle cx={x} cy={y} r="12" style={S('tree', 1.5)} />)}
              <text x="150" y="60" text-anchor="middle" style={T('ln', 13, 'letter-spacing:4px')}>UDLAP</text>
            </g>
            {/* RIANSA: factory, tanks, trucks */}
            <g transform="translate(300 0)">
              <rect x="40" y="40" width="150" height="118" style={S('w3')} />
              {[0, 1, 2, 3, 4, 5, 6].map((i) => <rect x="40" y={46 + i * 16} width="150" height="7" style="fill:var(--roof)" />)}
              <rect x="70" y="88" width="90" height="20" style={S('green', 1.5)} /><text x="115" y="102" text-anchor="middle" style={T('paper', 11, 'letter-spacing:1.5px')}>RIANSA</text>
              {[62, 124].map((y) => <><circle cx="232" cy={y} r="24" style={S('w2')} /><circle cx="232" cy={y} r="12" style={L(1.2)} /></>)}
              <rect x="40" y="176" width="220" height="84" style={S('road', 1.5)} />
              <path d={[0, 1, 2, 3, 4, 5, 6, 7].map((i) => `M${62 + i * 27} 176V200M${62 + i * 27} 236V260`).join('')} style={L(1.4, 'paint')} />
              {[[46, 'accent'], [100, 'dark'], [181, 'w2']].map(([x, f]) => <rect x={x} y="180" width="18" height="38" rx="3" style={S(f as string, 1.4)} />)}
            </g>
            {/* Piquero: the pool */}
            <g transform="translate(600 0)">
              <rect x="34" y="34" width="232" height="232" rx="6" style="fill:var(--w2)" />
              <rect x="56" y="58" width="188" height="128" rx="4" style={S('win')} />
              <path d={[1, 2, 3, 4, 5, 6, 7].map((i) => `M60 ${58 + i * 16}H240`).join('')} style="fill:none;stroke:var(--paper);stroke-width:1.6;stroke-dasharray:3 4" />
              <rect x="244" y="112" width="18" height="8" style={S('paper', 1.2)} />
