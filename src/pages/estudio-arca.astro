---
// Demo: Estudio Arca, an architecture studio (fictional). Photo-led: a full-bleed hero, a project index
// whose photo follows the cursor, and three principles with an image each.
// Photos: Unsplash (free licence), ids Vzm3aSLcnmg, bfOmSCQQHKQ, m993P9_lUXk, tKk7L7OIx40, p3P20nfqTg4, Xmh2Ang3-y4, tHlBSCq6vHg, qaO04vmpMd8.
import Demo from '../layouts/Demo.astro';
import { pic } from '../demos/pic';
const I = '/img/demos/arca/';
const projects = [
  ['2026', 'Casa Ladera', 'Valle de Bravo', '420 m²', 'Vivienda', 'ladera'],
  ['2025', 'Taller Tierra', 'Oaxaca', '180 m²', 'Cultura', 'taller'],
  ['2025', 'Patio 9', 'Mérida', '310 m²', 'Vivienda', 'patio'],
  ['2024', 'Mirador Norte', 'Monterrey', '1,200 m²', 'Oficinas', 'mirador'],
  ['2023', 'Casa Barranca', 'Malinalco', '260 m²', 'Vivienda', 'barranca'],
];
const principles = [
  ['01', 'Sitio', 'Antes de dibujar pasamos un día entero en el terreno: dónde sale el sol, de dónde viene el viento, qué árbol se queda.', 'materia'],
  ['02', 'Materia', 'Pocos materiales, honestos y locales. Concreto aparente, madera de la región, piedra del lugar.', 'ladera'],
  ['03', 'Luz', 'Cada espacio se diseña para una hora del día. La luz es el material que más cuidamos.', 'luz'],
];
---
<Demo title="Estudio Arca · Arquitectura" description="Estudio de arquitectura en Ciudad de México. Espacios que respiran." fonts="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700&display=swap" bg="#e9e7e2" color="#141414">
  <div class="arca">
    <header class="nav">
      <a href="#" class="logo">ARCA</a>
      <nav><a href="#obra">Obra</a><a href="#estudio">Estudio</a><a href="#contacto">Contacto</a></nav>
      <span class="loc">CDMX — 19.43° N</span>
    </header>

    <section class="hero">
      <h1>Espacios<br />que respiran<span>.</span></h1>
      <div class="meta">
        <p>Arquitectura en concreto, madera y luz.<br />Diseñamos casas y espacios culturales desde 2011.</p>
        <p class="count"><b>46</b> obras construidas</p>
      </div>
    </section>

    <figure class="cover">
      <img {...pic(`${I}hero`, '100vw', true)} alt="Voladizo de concreto contra el cielo" />
      <figcaption><span>Mirador Norte, Monterrey</span><span>2024</span></figcaption>
    </figure>

    <section id="obra" class="index">
      <h2>Obra seleccionada</h2>
      <table>
        <thead><tr><th>Año</th><th>Proyecto</th><th>Lugar</th><th>Superficie</th><th>Tipo</th></tr></thead>
        <tbody>{projects.map(([y, n, l, a, t, img]) => <tr data-img={`${I}${img}-800.webp`}><td>{y}</td><td>{n}</td><td>{l}</td><td>{a}</td><td>{t}</td></tr>)}</tbody>
      </table>
      <img class="peek" alt="" aria-hidden="true" />
    </section>

    <section id="estudio" class="studio">
      {principles.map(([n, t, d, img]) => (
        <div>
          <img {...pic(`${I}${img}`, '(max-width: 860px) 100vw, 33vw')} alt="" />
          <span>{n}</span><h3>{t}</h3><p>{d}</p>
        </div>
      ))}
    </section>

    <section id="contacto" class="contact">
      <h2>¿Tienes un terreno?</h2>
      <a href="mailto:hola@estudioarca.mx">hola@estudioarca.mx →</a>
    </section>
    <footer><span>Estudio Arca © 2026</span><span>Colima 214, Roma Norte, CDMX</span></footer>
  </div>
</Demo>

<script>
  // The project's photo follows the cursor over the index.
  const peek = document.querySelector<HTMLImageElement>('.peek')!;
  const rows = document.querySelectorAll<HTMLTableRowElement>('tr[data-img]');
  rows.forEach((r) => {
    new Image().src = r.dataset.img!;
    r.addEventListener('mouseenter', () => { peek.src = r.dataset.img!; peek.classList.add('on'); });
    r.addEventListener('mouseleave', () => peek.classList.remove('on'));
  });
  addEventListener('pointermove', (e) => { peek.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 120}px)`; });
</script>

<style>
  .arca { font-family: "Inter Tight", sans-serif; }
  .nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 22px clamp(20px, 4vw, 48px); font-size: 13px; text-transform: uppercase; letter-spacing: 0.14em; }
  .logo { font-weight: 700; font-size: 15px; letter-spacing: 0.4em; text-decoration: none; }
  .nav nav { display: flex; gap: 36px; }
  .nav nav a { text-decoration: none; }
  .loc { justify-self: end; color: #77736b; }
  .hero { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 30px; padding: 60px clamp(20px, 4vw, 48px) 40px; }
  h1 { font-size: clamp(3.6rem, 10vw, 10.5rem); font-weight: 300; line-height: 0.88; letter-spacing: -0.055em; margin: 0; }
  h1 span { color: #b5a58a; }
  .meta { text-align: right; font-size: 15px; line-height: 1.6; color: #4a4741; }
  .count { margin: 18px 0 0; text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px; }
  .count b { font-size: 28px; font-weight: 500; letter-spacing: 0; color: #141414; }
  .cover { margin: 0; position: relative; height: 88vh; min-height: 480px; }
  .cover img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.3) contrast(1.05); }
  .cover figcaption { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; padding: 18px clamp(20px, 4vw, 48px); font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #141414; background: linear-gradient(transparent, rgba(233, 231, 226, 0.85)); }

  .index { padding: 110px clamp(20px, 4vw, 48px); }
  h2 { font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 400; letter-spacing: -0.04em; margin: 0 0 40px; }
  table { width: 100%; border-collapse: collapse; font-size: 17px; }
  th { text-align: left; font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: #77736b; padding: 0 0 12px; border-bottom: 1px solid #141414; }
  td { padding: 22px 0; border-bottom: 1px solid #cfcbc3; transition: padding 0.25s, background 0.25s, color 0.25s; cursor: pointer; }
  tr:hover td { background: #141414; color: #e9e7e2; padding-left: 12px; }
  td:nth-child(2) { font-size: 26px; letter-spacing: -0.03em; }
  .peek { position: fixed; left: 0; top: 0; width: 320px; aspect-ratio: 4 / 5; object-fit: cover; pointer-events: none; opacity: 0; transition: opacity 0.25s; z-index: 10; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25); }
  .peek.on { opacity: 1; }

  .studio { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #141414; }
  .studio div { padding: 44px clamp(20px, 4vw, 48px) 70px; border-right: 1px solid #cfcbc3; }
  .studio img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 30px; filter: grayscale(0.2); }
  .studio span { font-size: 12px; color: #77736b; }
  .studio h3 { font-size: 34px; font-weight: 400; letter-spacing: -0.03em; margin: 14px 0; }
  .studio p { line-height: 1.65; color: #4a4741; max-width: 24em; margin: 0; }
  .contact { background: #141414; color: #e9e7e2; padding: 120px clamp(20px, 4vw, 48px); }
  .contact h2 { font-size: clamp(3rem, 8vw, 8rem); font-weight: 300; margin-bottom: 30px; }
  .contact a { font-size: clamp(1.2rem, 2.4vw, 2rem); text-decoration: none; border-bottom: 1px solid; }
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 22px clamp(20px, 4vw, 48px) 70px; background: #141414; color: #77736b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; }

  @media (max-width: 860px) {
    .nav { grid-template-columns: 1fr auto; }
    .nav nav { display: none; }
    .hero { grid-template-columns: 1fr; }
    .meta { text-align: left; }
    .studio { grid-template-columns: 1fr; }
    .peek { display: none; }
    th:nth-child(4), td:nth-child(4), th:nth-child(5), td:nth-child(5) { display: none; }
  }
</style>
