---
import Base from '../layouts/Base.astro';
type P = { t: string; role?: string; when?: string; d: string; stack: string; links?: [string, string][]; img?: [string, string][] };
const G = 'https://github.com/3zavalam/';
const work: P[] = [
  { t: 'Club León FC: scouting tool', role: 'Data Analyst & Software Development Intern', when: 'Aug 2026 – present', d: 'Data tool for the scouting team. Internal; no details shared here.', stack: 'Data tooling · Software development' },
  { t: 'INRS × Mitacs: AI and scraping research', role: 'Research Intern, Montreal', when: 'May – Aug 2026', d: "AI and web scraping research, including implementing a professor's paper that uses Kalman filters to predict World Cup outcomes.", stack: 'Python · Web scraping · Kalman filters' },
  { t: 'Piquero: event chatbot & Hy-Tek to Excel converter', role: 'Software Developer Intern', when: 'Summer 2025', d: 'A Q&A chatbot for a national swimming event, and a Python script that converts Hy-Tek (.hy3) files to Excel.', stack: 'Python · Chatbot · Data conversion' },
  { t: 'RIANSA: Power BI sales dashboards', role: 'Data Analyst Intern', when: 'Summer 2024', d: 'Power BI dashboards for sales data.', stack: 'Power BI · Sales analytics' },
];
const builds: P[] = [
  { t: 'Winner Way: AI tennis coach (most proud of)', d: "The one I'm most proud of, and the one I'm most disappointed I didn't continue. An AI tennis-coach app that analyzes tennis video.", stack: 'React · Python · Flask · OpenCV', links: [['Frontend', G + 'frontend'], ['Backend', G + 'ww-backend']] },
  { t: 'xG model', d: 'A logistic regression Expected Goals model trained on StatsBomb data from the 2022 FIFA World Cup.', stack: 'Python · scikit-learn · Pandas', links: [['GitHub', G + 'xG-Model']] },
  { t: 'Post-match dashboard', d: 'Match dashboards built from data scraped from SofaScore and Fotmob.', stack: 'Python · Web scraping · Data visualization', links: [['GitHub', G + 'Match-Report-Analysis']] },
  { t: 'Interactive Web: Liga MX & MLS', d: 'A Streamlit app with radar charts, shot maps and team stats for Liga MX and MLS matches.', stack: 'Python · Streamlit · BeautifulSoup · Matplotlib', links: [['GitHub', G + 'Interactive-Web']] },
  { t: 'Reservaciones: booking system', d: 'A reservation system for night clubs and venues.', stack: 'FastAPI · React · TypeScript · Supabase', links: [['GitHub', G + 'reservaciones']] },
];
const demos: P[] = [
  { t: 'Superstore sales dashboard', d: 'A Power BI sales dashboard on the public Sample Superstore data.', stack: 'Python · Star schema · Power BI / DAX', img: [['/img/superstore-1.png', 'Superstore dashboard overview page'], ['/img/superstore-2.png', 'Superstore dashboard detail page']] },
  { t: 'Messy files → clean Excel report', d: 'Messy CSV exports cleaned into an Excel report with Python. Synthetic data.', stack: 'Python · Pandas · openpyxl · cron', img: [['/img/messy-before.png', 'Raw messy CSV files before cleaning'], ['/img/messy-after.png', 'Clean Excel summary sheet after automation']] },
];
---
<Base title="Projects" description="Things I've built: Winner Way (AI tennis coach), Club León, research, sports data projects and demos.">
  <p class="eyebrow">Projects</p>
  <h1 class="serif mt-4 text-4xl tracking-tight sm:text-5xl">Things I've built</h1>
  <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-stone-600 dark:text-stone-400">Code is linked where it's public.</p>

  {[['Personal builds', builds], ['Work', work], ['Demos', demos]].map(([h, list]) => (
    <section class="mt-14">
      <h2 class="eyebrow">{h as string}</h2>
      <div class="mt-4 divide-y divide-stone-200 border-t border-stone-200 dark:divide-stone-800 dark:border-stone-800">
        {(list as P[]).map((p) => (
          <article class="py-8">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="serif text-2xl leading-snug">{p.t}</h3>
              {p.when && <p class="shrink-0 text-sm tabular-nums text-stone-500">{p.when}</p>}
            </div>
            {p.role && <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">{p.role}</p>}
            <p class="mt-3 leading-relaxed text-stone-700 dark:text-stone-300">{p.d}</p>
            {p.img && (
              <div class="mt-5 grid gap-3 sm:grid-cols-2">
                {p.img.map(([src, alt]) => <a href={src}><img src={src} alt={alt} loading="lazy" class="aspect-[16/10] w-full rounded-lg border border-stone-200 bg-white object-cover object-top dark:border-stone-800" /></a>)}
              </div>
            )}
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
              <span class="text-stone-500">{p.stack}</span>
              {p.links?.map(([l, u]) => <a class="link font-medium" href={u}>{l} ↗</a>)}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
