---
// Demo: PROBIS MVM, a property-services company in Mérida (from a Nuevas Mérida FB post; concept mock).
// Photo-led hero: house exterior in a tall rounded frame, paint inset and floating badges.
// Photos: Unsplash (free licence), ids 1581852017103-68ac65514cf7, 1562259949-e8e7689d7828,
// 1560448204-e02f11c3d0e2, 1600585154340-be6161a56a0c, 1416879595882-3373a0480b5b.
import Demo from '../layouts/Demo.astro';
import { pic } from '../demos/pic';

const services = [
  ['Pintura interior y exterior', 'Preparación de superficies y acabados limpios, dentro y fuera.', 'desde', 'cotizar'],
  ['Impermeabilización', 'Techos y muros con productos específicos para el clima de Yucatán.', 'desde', 'cotizar'],
  ['Mantenimiento de inmuebles', 'Reparaciones y mejoras para vivir o rentar sin dolores de cabeza.', 'desde', 'cotizar'],
  ['Tablaroca y acabados', 'Muros, plafones y detalles finos con personal capacitado.', 'desde', 'cotizar'],
  ['Limpieza con hidrolavadora', 'Fachadas, pisos y áreas exteriores como nuevas.', 'desde', 'cotizar'],
  ['Jardinería y áreas verdes', 'Poda, mantenimiento y espacios verdes que se notan.', 'desde', 'cotizar'],
];

const faq = [
  ['¿Atienden en toda Mérida?', 'Sí. Damos servicio en todo Mérida. Cuéntanos la colonia y el tipo de trabajo por WhatsApp.'],
  ['¿Cómo cotizan?', 'Mándanos fotos o una breve descripción. Te respondemos con alcance, materiales y precio por escrito.'],
  ['¿También venden pintura?', 'Sí. Vendemos y distribuimos pintura, y si prefieres, también la aplicamos.'],
];
---
<Demo title="PROBIS MVM · Tu proyecto, en buenas manos" description="Pintura, impermeabilización, mantenimiento y más en todo Mérida. Cotiza por WhatsApp." fonts="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" bg="#f7f4ef" color="#1c2420">
  <div class="pb">
    <header class="nav">
      <a href="#" class="logo"><span class="mark"></span>PROBIS MVM</a>
      <nav><a href="#servicios">Servicios</a><a href="#proceso">Cómo funciona</a><a href="#faq">Preguntas</a></nav>
      <a href="#cotizar" class="btn">Cotizar</a>
    </header>

    <section class="hero">
      <div class="copy">
        <p class="pill"><span></span>Servicio en todo Mérida</p>
        <h1>Tu proyecto,<br /><span>en buenas manos.</span></h1>
        <p class="lead">¿Necesitas mantenimiento, pintura o mejoras para tu inmueble? Nosotros nos encargamos de hacerlo profesionalmente y con acabados de calidad.</p>
        <div class="card" id="cotizar">
          <label>Servicio<select>
            <option>Pintura interior y exterior</option>
            <option>Impermeabilización</option>
            <option>Mantenimiento de inmuebles</option>
            <option>Tablaroca y acabados</option>
            <option>Limpieza con hidrolavadora</option>
            <option>Jardinería y áreas verdes</option>
            <option>Construcción ligera</option>
            <option>Venta de pintura</option>
          </select></label>
          <label>Colonia<input type="text" placeholder="Ej. Centro, García Ginerés" /></label>
          <a class="btn" href="https://wa.me/529991186275?text=Hola%20PROBIS%2C%20quiero%20una%20cotizaci%C3%B3n" target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <ul class="proof">
          <li><b>Personal</b> capacitado</li>
          <li><b>Materiales</b> de calidad</li>
          <li><b>999 118 6275</b></li>
        </ul>
      </div>
      <div class="art">
        <img class="main" {...pic('/img/demos/pronos/casa', '(max-width: 960px) 80vw, 40vw', true)} alt="Casa con fachada cuidada en Mérida" />
        <img class="inset" {...pic('/img/demos/pronos/pintura', '(max-width: 960px) 34vw, 17vw', true)} alt="Rodillo aplicando pintura" />
        <div class="float f1"><b>Pintura</b><span>Interior y exterior</span></div>
        <div class="float f2"><b>Mérida</b><span>Cobertura completa</span></div>
      </div>
    </section>

    <section id="servicios" class="services">
      <h2>Servicios con <span>acabados de calidad</span></h2>
      <div class="grid">
        {services.map(([t, d], i) => (
          <article>
            <span class="num">0{i + 1}</span>
            <h3>{t}</h3>
            <p>{d}</p>
            <div class="row"><span>Cotiza por WhatsApp</span><span class="time">respuesta rápida</span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="band-copy">
        <h2>También <span>pintura</span></h2>
        <p>Venta y distribución de pintura. Te ayudamos a elegir el producto correcto para el clima de Yucatán — y si quieres, también la aplicamos.</p>
        <a class="btn" href="https://wa.me/529991186275" target="_blank" rel="noopener">Pedir cotización</a>
      </div>
      <img {...pic('/img/demos/pronos/hero', '(max-width: 960px) 100vw, 48vw')} alt="Trabajo de pintura en muro" />
    </section>

    <section id="proceso" class="steps">
      <h2>Así trabajamos</h2>
      <ol>
        <li><b>Cuéntanos el proyecto</b><span>Escríbenos por WhatsApp con fotos o una breve descripción.</span></li>
        <li><b>Cotización clara</b><span>Te respondemos con alcance, materiales y precio, por escrito.</span></li>
        <li><b>Trabajo profesional</b><span>Personal capacitado, materiales de calidad y acabados que duran.</span></li>
      </ol>
    </section>

    <section class="gallery">
      <img {...pic('/img/demos/pronos/interior', '(max-width: 900px) 100vw, 33vw')} alt="Interior renovado" />
      <img {...pic('/img/demos/pronos/jardin', '(max-width: 900px) 100vw, 33vw')} alt="Área verde cuidada" />
      <img {...pic('/img/demos/pronos/muro', '(max-width: 900px) 100vw, 33vw')} alt="Detalle de pintura" />
    </section>

    <section id="faq" class="faq">
      <h2>Preguntas frecuentes</h2>
      {faq.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
    </section>

    <footer>
      <div><b>PROBIS MVM</b><br />Proveedora de Bienes y Servicios · Mérida</div>
      <div>WhatsApp · 999 118 6275<br />Tu proyecto, en buenas manos.</div>
    </footer>
  </div>
</Demo>

<style>
  .pb { font-family: "Plus Jakarta Sans", sans-serif; --ink: #1c2420; --clay: #c45b2c; --sand: #f7f4ef; --card: #fffdf9; --muted: #5b675f; --line: #e6e0d6; }
  .nav { display: flex; align-items: center; justify-content: space-between; padding: 20px clamp(20px, 5vw, 64px); }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 20px; text-decoration: none; letter-spacing: -0.02em; }
  .mark { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #e8a070, var(--clay)); box-shadow: inset 0 -6px 0 rgba(255, 255, 255, 0.28); }
  .nav nav { display: flex; gap: 30px; font-weight: 500; font-size: 15px; }
  .nav nav a { text-decoration: none; opacity: 0.75; }
  .btn { background: var(--ink); color: #fff; border: 0; border-radius: 14px; padding: 13px 22px; font-weight: 600; text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }

  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 20px; align-items: center; padding: 30px clamp(20px, 5vw, 64px) 70px; background: radial-gradient(ellipse 60% 70% at 78% 45%, #f0e2d2 0%, rgba(247, 244, 239, 0) 70%); }
  .pill { display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px; font-size: 13px; font-weight: 600; margin: 0; }
  .pill span { width: 8px; height: 8px; border-radius: 50%; background: #2fcf8a; box-shadow: 0 0 0 4px rgba(47, 207, 138, 0.18); }
  h1 { font-size: clamp(3.2rem, 7vw, 6.4rem); line-height: 0.95; letter-spacing: -0.05em; font-weight: 800; margin: 22px 0 0; }
  h1 span { color: var(--clay); }
  .lead { font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 30em; margin: 22px 0 28px; }
  .card { display: grid; grid-template-columns: 1.3fr 1fr auto; gap: 10px; align-items: end; background: #fff; border-radius: 20px; padding: 14px; box-shadow: 0 20px 50px rgba(28, 36, 32, 0.1); max-width: 640px; }
  .card label { display: grid; gap: 4px; font-size: 12px; font-weight: 600; color: #7a857c; }
  .card select, .card input { border: 1px solid var(--line); border-radius: 12px; padding: 11px 12px; background: var(--sand); font-weight: 500; color: var(--ink); }
  .proof { display: flex; gap: 28px; flex-wrap: wrap; list-style: none; padding: 0; margin: 26px 0 0; font-size: 14px; color: var(--muted); }
  .proof b { color: var(--ink); font-size: 16px; }
  .art { position: relative; aspect-ratio: 1; }
  .art .main { position: absolute; inset: 4% 8% 4% 14%; width: 78%; height: 92%; object-fit: cover; border-radius: 240px 240px 28px 28px; box-shadow: 0 40px 80px rgba(28, 36, 32, 0.15); }
  .art .inset { position: absolute; left: 0; bottom: 8%; width: 34%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 8px solid #fff; box-shadow: 0 20px 40px rgba(28, 36, 32, 0.15); }
  .float { position: absolute; display: grid; gap: 2px; background: rgba(255, 255, 255, 0.78); backdrop-filter: blur(12px); border: 1px solid #fff; border-radius: 16px; padding: 12px 16px; font-size: 13px; box-shadow: 0 12px 30px rgba(28, 36, 32, 0.08); animation: up 5s ease-in-out infinite; }
  .float span { color: #7a857c; }
  .f1 { left: 0; top: 16%; }
  .f2 { right: 4%; bottom: 18%; animation-delay: -2.5s; }
  @keyframes up { 50% { transform: translateY(-10px); } }

  .services, .steps, .faq { padding: 100px clamp(20px, 5vw, 64px); max-width: 1240px; margin: 0 auto; }
  h2 { font-size: clamp(2.2rem, 4vw, 3.6rem); letter-spacing: -0.04em; font-weight: 800; margin: 0 0 44px; }
  h2 span { color: var(--clay); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  article { background: var(--card); border-radius: 22px; padding: 26px; display: flex; flex-direction: column; border: 1px solid var(--line); transition: transform 0.25s, box-shadow 0.25s; }
  article:hover { transform: translateY(-6px); box-shadow: 0 24px 50px rgba(28, 36, 32, 0.1); }
  .num { font-size: 13px; font-weight: 700; color: var(--clay); }
  article h3 { font-size: 20px; margin: 30px 0 8px; letter-spacing: -0.02em; }
  article p { color: var(--muted); line-height: 1.55; margin: 0 0 24px; flex: 1; font-size: 15px; }
  .row { display: flex; justify-content: space-between; gap: 10px; border-top: 1px solid var(--line); padding-top: 14px; font-size: 14px; }
  .time { color: #7a857c; }

  .band { display: grid; grid-template-columns: 1fr 1.15fr; gap: 28px; align-items: center; margin: 0 clamp(20px, 5vw, 64px); padding: 36px; border-radius: 28px; background: var(--ink); color: #f7f4ef; }
  .band h2 { margin: 0 0 16px; }
  .band h2 span { color: #e8a070; }
  .band p { color: #b7c0b9; line-height: 1.65; max-width: 30em; margin: 0 0 24px; }
  .band .btn { background: var(--clay); }
  .band img { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; border-radius: 20px; }

  .steps ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: s; }
  .steps li { counter-increment: s; background: var(--ink); color: #fff; border-radius: 22px; padding: 28px; display: grid; gap: 8px; }
  .steps li::before { content: counter(s); width: 36px; height: 36px; border-radius: 50%; background: var(--clay); display: grid; place-items: center; font-weight: 700; margin-bottom: 18px; }
  .steps li b { font-size: 20px; }
  .steps li span { color: #a9b5ad; line-height: 1.55; }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding: 0 clamp(20px, 5vw, 64px) 40px; max-width: 1240px; margin: 0 auto; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 22px; }

  details { border-bottom: 1px solid var(--line); padding: 20px 0; }
  summary { font-weight: 700; font-size: 18px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; }
  summary::after { content: '+'; color: var(--clay); font-size: 24px; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { color: var(--muted); line-height: 1.6; margin: 12px 0 0; max-width: 44em; }
  footer { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 40px clamp(20px, 5vw, 64px) 70px; background: #ebe4da; line-height: 1.6; font-size: 14px; }

  @media (max-width: 960px) {
    .nav nav { display: none; }
    .hero, .band, .grid, .steps ol, .gallery { grid-template-columns: 1fr; }
    .card { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .grid, .steps ol { grid-template-columns: 1fr; }
  }
</style>
