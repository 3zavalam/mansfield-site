---
// Demo: PROBIS MVM — Proveedora de bienes y servicios in Mérida (from a Nuevas Mérida FB post).
// Route /pronos per portfolio slug; concept mock, not the client's live site.
// Photos: Unsplash (free licence) — wall paint, house exterior, garden, roller.
import Demo from '../layouts/Demo.astro';
import { pic } from '../demos/pic';

const services = [
  ['Pintura interior y exterior', 'Acabados limpios, preparación de superficies y colores a tu medida.', 'pintura'],
  ['Impermeabilización', 'Protección de techos y muros con productos específicos para el clima de Yucatán.', 'muro'],
  ['Mantenimiento de inmuebles', 'Reparaciones, mejoras y listo para rentar o vivir sin dolores de cabeza.', 'casa'],
  ['Tablaroca y acabados', 'Muros, plafones y detalles finos con personal capacitado.', 'pintura'],
  ['Limpieza con hidrolavadora', 'Fachadas, pisos y áreas exteriores como nuevas.', 'casa'],
  ['Jardinería y áreas verdes', 'Poda, mantenimiento y espacios verdes que se notan.', 'jardin'],
];

const steps = [
  ['Cuéntanos el proyecto', 'Escríbenos por WhatsApp con fotos o una breve descripción de lo que necesitas.'],
  ['Cotización clara', 'Te respondemos con alcance, materiales y precio — sin sorpresas.'],
  ['Trabajo profesional', 'Personal capacitado, materiales de calidad y acabados que duran.'],
];
---
<Demo
  title="PROBIS MVM · Tu proyecto, en buenas manos"
  description="Pintura, impermeabilización, mantenimiento y más en todo Mérida. Cotiza por WhatsApp."
  fonts="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,500&family=Bebas+Neue&display=swap"
  bg="#f6f3ec"
  color="#15202b"
>
  <div class="pb">
    <header class="nav">
      <a href="#" class="logo"><span class="mark">P</span>PROBIS <em>MVM</em></a>
      <nav>
        <a href="#servicios">Servicios</a>
        <a href="#proceso">Cómo trabajamos</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="btn wa" href="https://wa.me/529991186275" target="_blank" rel="noopener">WhatsApp 999 118 6275</a>
    </header>

    <section class="hero">
      <div class="copy">
        <p class="pill"><span></span> Servicio en todo Mérida</p>
        <h1>Tu inmueble,<br /><span>en buenas manos.</span></h1>
        <p class="lead">
          ¿Necesitas mantenimiento, pintura o mejoras? PROBIS MVM — Proveedora de Bienes y Servicios —
          lo hace de forma profesional, con acabados de calidad.
        </p>
        <div class="cta">
          <a class="btn wa lg" href="https://wa.me/529991186275" target="_blank" rel="noopener">Cotiza hoy por WhatsApp</a>
          <a class="btn ghost" href="#servicios">Ver servicios</a>
        </div>
        <ul class="proof">
          <li><b>Personal</b> capacitado</li>
          <li><b>Materiales</b> de calidad</li>
          <li><b>Todo</b> Mérida</li>
        </ul>
      </div>
      <div class="art">
        <img class="main" {...pic('/img/demos/pronos/casa', '(max-width: 960px) 92vw, 46vw', true)} alt="Fachada de casa con acabado de pintura" />
        <img class="inset" {...pic('/img/demos/pronos/pintura', '(max-width: 960px) 40vw, 18vw', true)} alt="Rodillo de pintura" />
        <div class="float f1"><b>Pintura</b><span>Interior y exterior</span></div>
        <div class="float f2"><b>WhatsApp</b><span>999 118 6275</span></div>
      </div>
    </section>

    <section class="strip" aria-hidden="true">
      <div class="marquee">
        <span>Pintura</span><span>·</span><span>Impermeabilización</span><span>·</span><span>Mantenimiento</span><span>·</span>
        <span>Tablaroca</span><span>·</span><span>Hidrolavado</span><span>·</span><span>Jardinería</span><span>·</span>
        <span>Construcción ligera</span><span>·</span>
        <span>Pintura</span><span>·</span><span>Impermeabilización</span><span>·</span><span>Mantenimiento</span><span>·</span>
        <span>Tablaroca</span><span>·</span><span>Hidrolavado</span><span>·</span><span>Jardinería</span><span>·</span>
        <span>Construcción ligera</span><span>·</span>
      </div>
    </section>

    <section id="servicios" class="services">
      <div class="head">
        <p class="eyebrow">Qué hacemos</p>
        <h2>Servicios para tu <em>inmueble</em></h2>
        <p class="sub">Desde un retoque de pintura hasta mejoras generales y construcción ligera.</p>
      </div>
      <div class="grid">
        {services.map(([t, d, img]) => (
          <article>
            <div class="photo"><img {...pic(`/img/demos/pronos/${img}`, '(max-width: 900px) 100vw, 33vw')} alt="" /></div>
            <h3>{t}</h3>
            <p>{d}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sale">
      <div class="sale-copy">
        <p class="eyebrow">Además</p>
        <h2>Venta y distribución de <em>pintura</em></h2>
        <p>Te ayudamos a elegir el producto correcto para el clima de Mérida — y si prefieres, también aplicamos.</p>
      </div>
      <img {...pic('/img/demos/pronos/muro', '(max-width: 900px) 100vw, 48vw')} alt="Muro con acabado de pintura fresca" />
    </section>

    <section id="proceso" class="steps">
      <h2>Tres pasos. <em>Sin rodeos.</em></h2>
      <ol>
        {steps.map(([t, d], i) => (
          <li>
            <span class="n">0{i + 1}</span>
            <b>{t}</b>
            <span>{d}</span>
          </li>
        ))}
      </ol>
    </section>

    <section id="contacto" class="contact">
      <div>
        <h2>¡Cotiza <em>hoy!</em></h2>
        <p>Mándanos un mensaje con lo que necesitas. Respondemos por WhatsApp.</p>
        <a class="btn wa lg" href="https://wa.me/529991186275" target="_blank" rel="noopener">999 118 6275</a>
      </div>
      <aside>
        <p><b>PROBIS MVM</b></p>
        <p>Proveedora de Bienes y Servicios</p>
        <p>Mérida, Yucatán</p>
        <p class="muted">Dirección de oficina: (mock) Calle 60 × 57, Centro</p>
        <img {...pic('/img/demos/pronos/jardin', '(max-width: 900px) 100vw, 40vw')} alt="Área verde cuidada" />
      </aside>
    </section>

    <footer>
      <span>PROBIS MVM — Tu proyecto, en buenas manos.</span>
      <span>Concepto de sitio · Mansfield</span>
    </footer>
  </div>
</Demo>

<style>
  .pb {
    font-family: "DM Sans", system-ui, sans-serif;
    --ink: #15202b;
    --amber: #f0a202;
    --amber-deep: #e85d04;
    --paper: #f6f3ec;
    --card: #fffdf8;
    --muted: #5c6b7a;
    --line: #e4ddd0;
    --wa: #25d366;
  }
  em { font-style: italic; color: var(--amber-deep); }
  .nav {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px clamp(18px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
    background: rgba(246, 243, 236, 0.9);
    backdrop-filter: blur(10px);
    position: sticky; top: 0; z-index: 20;
  }
  .logo {
    display: inline-flex; align-items: center; gap: 10px;
    font-weight: 800; letter-spacing: -0.03em; text-decoration: none; font-size: 18px;
  }
  .logo em { font-style: normal; color: var(--amber-deep); font-weight: 700; }
  .mark {
    width: 28px; height: 28px; border-radius: 8px;
    display: grid; place-items: center; font-size: 14px; font-weight: 800;
    color: #fff; background: linear-gradient(135deg, var(--amber), var(--amber-deep));
  }
  .nav nav { display: flex; gap: 26px; font-weight: 600; font-size: 14px; }
  .nav nav a { text-decoration: none; opacity: 0.72; }
  .nav nav a:hover { opacity: 1; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    border: 0; border-radius: 999px; padding: 11px 18px; font-weight: 700;
    text-decoration: none; cursor: pointer; font-size: 14px;
  }
  .btn.wa { background: var(--wa); color: #083318; }
  .btn.wa:hover { filter: brightness(0.95); }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .btn.lg { padding: 15px 24px; font-size: 16px; }

  .hero {
    display: grid; grid-template-columns: 1.05fr 1fr; gap: 28px; align-items: center;
    padding: 40px clamp(18px, 4vw, 56px) 70px;
  }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; margin: 0;
    background: #fff; border: 1px solid var(--line); border-radius: 999px;
    padding: 7px 14px; font-size: 13px; font-weight: 700;
  }
  .pill span {
    width: 8px; height: 8px; border-radius: 50%; background: var(--wa);
    box-shadow: 0 0 0 4px rgba(37, 211, 102, 0.2);
  }
  h1 {
    font-family: "Bebas Neue", "DM Sans", sans-serif;
    font-size: clamp(3.6rem, 9vw, 6.8rem); line-height: 0.92;
    letter-spacing: 0.01em; margin: 18px 0 0; font-weight: 400;
  }
  h1 span { color: var(--amber-deep); }
  .lead {
    font-size: 17px; line-height: 1.65; color: var(--muted);
    max-width: 34em; margin: 18px 0 26px;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .proof {
    display: flex; flex-wrap: wrap; gap: 22px; list-style: none;
    padding: 0; margin: 28px 0 0; font-size: 14px; color: var(--muted);
  }
  .proof b { color: var(--ink); }

  .art { position: relative; aspect-ratio: 1 / 1.05; }
  .art .main {
    position: absolute; inset: 0 0 8% 8%; width: 92%; height: 92%;
    object-fit: cover; border-radius: 28px 28px 10px 28px;
    box-shadow: 0 30px 70px rgba(21, 32, 43, 0.18);
  }
  .art .inset {
    position: absolute; left: 0; bottom: 0; width: 38%; aspect-ratio: 1;
    object-fit: cover; border-radius: 22px; border: 7px solid var(--paper);
    box-shadow: 0 18px 40px rgba(21, 32, 43, 0.16);
  }
  .float {
    position: absolute; display: grid; gap: 2px;
    background: rgba(255, 253, 248, 0.9); backdrop-filter: blur(10px);
    border: 1px solid #fff; border-radius: 16px; padding: 12px 16px;
    font-size: 13px; box-shadow: 0 12px 28px rgba(21, 32, 43, 0.1);
    animation: bob 5s ease-in-out infinite;
  }
  .float span { color: var(--muted); }
  .f1 { right: 0; top: 12%; }
  .f2 { right: 6%; bottom: 18%; animation-delay: -2.4s; }
  @keyframes bob { 50% { transform: translateY(-9px); } }

  .strip {
    overflow: hidden; border-block: 1px solid var(--line);
    background: var(--ink); color: #f6f3ec; padding: 14px 0;
  }
  .marquee {
    display: flex; gap: 18px; white-space: nowrap;
    font-family: "Bebas Neue", sans-serif; font-size: 28px; letter-spacing: 0.04em;
    animation: scroll 28s linear infinite; width: max-content;
  }
  .marquee span:nth-child(even) { color: var(--amber); opacity: 0.85; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  .services, .steps { padding: 90px clamp(18px, 4vw, 56px); max-width: 1280px; margin: 0 auto; }
  .eyebrow {
    font-size: 12px; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--amber-deep); margin: 0 0 10px;
  }
  h2 {
    font-family: "Bebas Neue", sans-serif; font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4.2rem); letter-spacing: 0.02em;
    line-height: 1; margin: 0;
  }
  .sub { color: var(--muted); max-width: 36em; margin: 14px 0 0; line-height: 1.6; }
  .head { margin-bottom: 40px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  article {
    background: var(--card); border: 1px solid var(--line); border-radius: 22px;
    overflow: hidden; display: flex; flex-direction: column;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  article:hover { transform: translateY(-5px); box-shadow: 0 22px 48px rgba(21, 32, 43, 0.1); }
  .photo { aspect-ratio: 16 / 10; overflow: hidden; background: #ddd; }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.45s; }
  article:hover .photo img { transform: scale(1.05); }
  article h3 { font-size: 19px; margin: 18px 18px 8px; letter-spacing: -0.02em; }
  article p { margin: 0 18px 20px; color: var(--muted); line-height: 1.55; font-size: 14px; flex: 1; }

  .sale {
    display: grid; grid-template-columns: 1fr 1.1fr; gap: 28px; align-items: center;
    margin: 0 clamp(18px, 4vw, 56px); padding: 28px; border-radius: 28px;
    background: var(--ink); color: #f6f3ec;
  }
  .sale em { color: var(--amber); }
  .sale-copy .eyebrow { color: var(--amber); }
  .sale-copy p:last-child { color: #b7c3d1; line-height: 1.65; max-width: 30em; }
  .sale img { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; border-radius: 20px; }

  .steps h2 { margin-bottom: 36px; }
  .steps ol {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  }
  .steps li {
    background: var(--card); border: 1px solid var(--line); border-radius: 22px;
    padding: 26px; display: grid; gap: 10px;
  }
  .steps .n {
    font-family: "Bebas Neue", sans-serif; font-size: 40px; color: var(--amber-deep); line-height: 1;
  }
  .steps li b { font-size: 18px; }
  .steps li > span:last-child { color: var(--muted); line-height: 1.55; font-size: 15px; }

  .contact {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 36px;
    padding: 90px clamp(18px, 4vw, 56px); max-width: 1280px; margin: 0 auto; align-items: start;
  }
  .contact > div p { color: var(--muted); line-height: 1.6; max-width: 30em; }
  .contact .btn { margin-top: 10px; }
  aside {
    background: var(--card); border: 1px solid var(--line); border-radius: 24px;
    padding: 22px; display: grid; gap: 6px;
  }
  aside p { margin: 0; }
  aside .muted { color: var(--muted); font-size: 13px; margin-top: 6px !important; }
  aside img { margin-top: 14px; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 16px; }

  footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    padding: 28px clamp(18px, 4vw, 56px) 72px; font-size: 13px; color: var(--muted);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .nav nav { display: none; }
    .hero, .sale, .contact, .grid, .steps ol { grid-template-columns: 1fr; }
    .nav .btn.wa { font-size: 12px; padding: 10px 12px; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
