---
// /resources/museums: a gallery wall. Each photo hangs in a frame under its own picture light, with a museum
// label (wall text) saying what caught my eye. Up top, one ticket stub per museum visited: pick one to light
// only its pieces. Click a frame for a closer look.
import Base from '../../layouts/Base.astro';
import ResourceTitle from '../../components/ResourceTitle.astro';
import SampleNote from '../../components/SampleNote.astro';
import ResourceEnter from '../../components/ResourceEnter.astro';
import { MUSEUMS, hasSamples, bg } from '../../resources';
const visits = [...new Map(MUSEUMS.map((m) => [`${m.museum}|${m.city}|${m.year ?? ''}`, m])).values()];
const key = (m: { museum: string; city: string; year?: string }) => `${m.museum}|${m.city}|${m.year ?? ''}`;
---
<Base title="Museums">
  <ResourceEnter slot="head" slug="museums" />
  <ResourceTitle label="Museums" count={MUSEUMS.length} />
  <SampleNote show={hasSamples(MUSEUMS)} />

  {/* Ticket stubs, one per visit */}
  <div class="tickets flex flex-wrap gap-2" role="group" aria-label="Show pieces from one museum">
    <button type="button" class="ticket on" data-key="">All</button>
    {visits.map((v) => (
      <button type="button" class="ticket" data-key={key(v)}>
        <span class="font-semibold">{v.museum}</span><span class="opacity-60"> · {v.city}{v.year && ` · ${v.year}`}</span>
      </button>
    ))}
  </div>

  {/* The wall */}
  <div class="wall relative left-1/2 mt-6 w-screen -translate-x-1/2 px-4 py-12 sm:px-8 sm:py-16">
    <ul class="rise mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-12 gap-y-14 sm:gap-x-16">
      {MUSEUMS.map((m, i) => (
        <li class="piece flex items-end gap-4" data-key={key(m)} style={`--i:${i}`}>
          <button type="button" class="frame-btn group relative" data-i={i} aria-label={`${m.title ?? m.museum}, ${m.museum}, ${m.city}: closer look`}>
            <span class="light" aria-hidden="true"></span>
            <span class="frame block">
              <span class:list={['mat block', `size-${m.size ?? 'm'}`]}>
                <span class="art block" style={m.img ? (m.w && m.h ? `aspect-ratio:${m.w}/${m.h}` : '') : `background:${bg(m.tone)}`}>
                  {m.img && <img src={m.sm ?? m.img} alt={m.title ?? m.museum} loading="lazy" width={m.w} height={m.h} class="h-full w-full object-cover" />}
                </span>
              </span>
            </span>
          </button>
          <span class="label">
            {m.section && <span class="mono block pb-1 text-[9px] uppercase tracking-wider text-stone-400">{m.section}</span>}
            {m.title && <span class="block font-semibold leading-snug">{m.title}</span>}
            {m.note && <span class="block py-1 leading-snug text-stone-700">{m.note.split('\n').filter((l) => !l.startsWith('>')).join(' ')}</span>}
            <span class:list={['block', m.title ? 'text-stone-500' : 'font-semibold leading-snug']}>{m.museum}</span>
            <span class="block text-stone-500">{m.city}{m.year && `, ${m.year}`}</span>
          </span>
        </li>
      ))}
    </ul>
    <span class="floor" aria-hidden="true"></span>
  </div>

  {MUSEUMS.some((m) => !m.img) && (
    <section class="mx-auto mt-10 max-w-2xl">
      <h2 class="eyebrow mb-3">Also caught my eye</h2>
      <ul class="space-y-3 text-[16px] leading-relaxed">
        {MUSEUMS.filter((m) => !m.img).map((m) => <li>{m.title && <strong class="font-semibold">{m.title}. </strong>}{m.note}<span class="text-stone-500"> · {m.museum}</span></li>)}
      </ul>
    </section>
  )}

  {/* Closer look */}
  <dialog class="closer">
    {MUSEUMS.map((m, i) => (
      <article data-i={i} hidden class="grid items-center gap-6 sm:grid-cols-[auto_16rem]">
        <span class="frame block"><span class="mat block"><span class="art block" style={m.img ? (m.w && m.h ? `aspect-ratio:${m.w}/${m.h}` : '') : `background:${bg(m.tone)}`}>{m.img && <img src={m.img} alt={m.title ?? m.museum} loading="lazy" class="h-full w-full object-contain" />}</span></span></span>
        <div class="label big">
          <p class="font-semibold leading-snug">{m.title ?? m.museum}</p>
          <p class="text-stone-500">{m.title && `${m.museum} · `}{m.city}{m.year && `, ${m.year}`}</p>
          {m.note && <div class="mt-3 space-y-2 leading-relaxed">{m.note.split('\n').map((l) => l.startsWith('>') ? <p class="border-l-2 border-stone-300 pl-3 text-[14px] italic text-stone-600">{l.replace(/^>\s*/, '')}</p> : <p>{l}</p>)}</div>}
        </div>
      </article>
    ))}
    <form method="dialog"><button class="closer-close" aria-label="Close">×</button></form>
  </dialog>
</Base>

<style>
  .ticket {
    position: relative; padding: 7px 16px 7px 14px; font-size: 13px; color: #3b2f22; background: #f3e3c3;
    border-radius: 4px; border-left: 2px dashed rgb(59 47 34 / .35);
    /* Notched ends like a stub */
    -webkit-mask: radial-gradient(circle 5px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 5px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
            mask: radial-gradient(circle 5px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 5px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    transition: background-color .2s ease, transform .2s ease;
  }
  .ticket:hover { transform: translateY(-2px); }
  .ticket.on { background: #3b2f22; color: #f3e3c3; }

  .wall { background: linear-gradient(#ece5d9, #e4dccd); }
  :global(.dark) .wall { background: linear-gradient(#2b2621, #231f1b); }
  .floor { position: absolute; left: 0; right: 0; bottom: 0; height: 10px; background: #cfc4b2; box-shadow: 0 -1px 0 rgb(0 0 0 / .06); }
  :global(.dark) .floor { background: #3a332c; }
  .piece { transition: opacity .35s ease, filter .35s ease; }
  .piece.dim { opacity: .18; filter: grayscale(1); }

  /* Frame, mat, picture light */
  .frame { padding: 9px; background: linear-gradient(145deg, #2a2420, #120f0d); box-shadow: 0 1px 0 rgb(255 255 255 / .1) inset, 0 14px 22px -10px rgb(0 0 0 / .45); }
  .mat { padding: 14px; background: #fbf9f4; box-shadow: inset 0 0 0 1px rgb(0 0 0 / .06), inset 2px 2px 6px rgb(0 0 0 / .08); }
  .art { overflow: hidden; }
  .size-s .art { width: 150px; aspect-ratio: 4 / 3; }
  .size-m .art { width: 190px; aspect-ratio: 1; }
  .size-l .art { width: 230px; aspect-ratio: 4 / 5; }
  @media (max-width: 640px) { .size-s .art { width: 120px; } .size-m .art { width: 150px; } .size-l .art { width: 180px; } }
  .frame-btn { cursor: zoom-in; transition: transform .25s ease; }
  .frame-btn:hover { transform: translateY(-3px); }
  .frame-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 6px; }
  .light { position: absolute; left: 50%; top: -26px; width: 46%; height: 8px; translate: -50% 0; border-radius: 4px; background: linear-gradient(#c9a65a, #8a6c2f); }
  .light::after { content: ''; position: absolute; left: -20%; right: -20%; top: 6px; height: 120px; background: radial-gradient(ellipse at top, rgb(255 236 190 / .45), transparent 70%); pointer-events: none; }
  .label { max-width: 14rem; padding: 8px 10px; font-size: 11px; background: #fff; color: #1a1917; box-shadow: 0 1px 2px rgb(0 0 0 / .08); }
  .label.big { max-width: none; font-size: 15px; padding: 16px 18px; }

  .closer { margin: auto; width: min(94vw, 760px); padding: 32px; border: 0; border-radius: 14px; background: #ece5d9; overflow: visible; }
  :global(.dark) .closer { background: #2b2621; }
  .closer::backdrop { background: rgb(12 12 12 / .6); backdrop-filter: blur(4px); }
  .closer[open] { animation: up .25s ease; }
  .closer .mat .art { width: min(60vw, 380px); aspect-ratio: 4 / 5; }
  .closer .mat .art[style*='aspect-ratio'] { width: auto; max-width: min(60vw, 420px); max-height: 70vh; }
  .closer .mat .art img { max-height: 70vh; }
  .size-m .art[style*='aspect-ratio'] { width: 230px; }
  .size-l .art[style*='aspect-ratio'] { width: 190px; }
  .closer-close { position: absolute; right: -12px; top: -12px; width: 36px; height: 36px; border-radius: 50%; background: #fff; color: #1a1917; font-size: 20px; line-height: 1; }
  @keyframes up { from { opacity: 0; transform: translateY(12px) scale(.97); } }
  @media (prefers-reduced-motion: reduce) { .piece, .frame-btn, .ticket { transition: none; } .closer[open] { animation: none; } }
</style>

<script>
  // Tickets: light only one museum's pieces.
  const tickets = document.querySelectorAll<HTMLButtonElement>('.ticket');
  const pieces = document.querySelectorAll<HTMLElement>('.piece');
  tickets.forEach((t) => t.addEventListener('click', () => {
    tickets.forEach((o) => o.classList.toggle('on', o === t));
    pieces.forEach((p) => p.classList.toggle('dim', !!t.dataset.key && p.dataset.key !== t.dataset.key));
  }));
  // Frames: a closer look.
  const closer = document.querySelector<HTMLDialogElement>('.closer')!;
  const looks = closer.querySelectorAll<HTMLElement>('article');
  document.querySelectorAll<HTMLButtonElement>('.frame-btn').forEach((b) => b.addEventListener('click', () => {
    looks.forEach((a) => (a.hidden = a.dataset.i !== b.dataset.i));
    closer.showModal();
  }));
  closer.addEventListener('click', (e) => { if (e.target === closer) closer.close(); });
</script>
