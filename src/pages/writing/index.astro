---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../posts';
const posts = await getPosts();
---
<Base title="Writing" description="Analysis of businesses, mainly sports companies.">
  <p class="eyebrow">Writing</p>
  <h1 class="serif mt-4 text-4xl tracking-tight sm:text-5xl">Writing</h1>
  <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-stone-600 dark:text-stone-400">I'm writing just about analysis of businesses, mainly sports companies, but not at a very serious or good level, because I'm starting.</p>
  <div class="mt-10"><PostList posts={posts} /></div>
</Base>
