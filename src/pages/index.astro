---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../posts';
const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <section>
    <p class="eyebrow">Runnin' down my dream</p>
    <h1 class="serif mt-4 text-[2.6rem] leading-[1.05] tracking-tight sm:text-6xl">Mansfield</h1>
  </section>

  <section class="mt-10 max-w-2xl space-y-4 text-[17px] leading-relaxed text-stone-700 dark:text-stone-300">
    <p>I'm just a guy who wants to learn, who overthinks way too much, and who sometimes doesn't feel like he deserves everything he has.</p>
    <p>My dream is to live off what I like doing. I don't like the word job. <a class="link" href="/about">About me →</a></p>
  </section>

  <section class="mt-16">
    <div class="flex items-baseline justify-between"><h2 class="eyebrow">Now</h2><a href="/now" class="text-sm text-stone-500 hover:text-accent dark:text-stone-400">More →</a></div>
    <p class="mt-4 max-w-2xl text-[17px] leading-relaxed text-stone-700 dark:text-stone-300">I'm in the León internship online, and I'm living in my hometown while I go to Spain.</p>
  </section>

  {posts.length > 0 && (
  <section class="mt-16">
    <div class="flex items-baseline justify-between"><h2 class="eyebrow">Latest writing</h2><a href="/writing" class="text-sm text-stone-500 hover:text-accent dark:text-stone-400">All →</a></div>
    <div class="mt-2"><PostList posts={posts} /></div>
  </section>
  )}

  <section class="mt-16 rounded-2xl bg-ink px-6 py-10 text-paper sm:px-10 dark:bg-stone-100 dark:text-night">
    <p class="eyebrow !text-stone-400 dark:!text-stone-500">Work with me</p>
    <p class="mt-3 max-w-xl text-lg leading-relaxed text-stone-200 dark:text-stone-700">I like doing the data stuff and I'm more experienced there, but helping people get the last 20% of their MVPs, I'd love that.</p>
    <a href="/work-with-me" class="mt-7 inline-block rounded-full bg-paper px-5 py-2.5 text-sm font-medium text-ink transition hover:bg-accent hover:text-white dark:bg-night dark:text-stone-100">Work with me →</a>
  </section>
</Base>
