---
// Home: the landing for the Facebook click-to-WhatsApp ads (Nov 2026), aimed at dental clinics. The ad shows a WhatsApp chatbot
// for a dental clinic, so the hero uses the ad's copy and replays that conversation (animated); then what the bot does, the price
// with the free-install promo, FAQ, a last CTA, and the other services as cards at the bottom (Webs links to /webs, the portfolio).
// The previous web-only landing is kept in src/drafts/landing-tries/index-webs.astro; the Mac-scene home in _home-mac.astro.
import Base from '../layouts/Base.astro';
import { waLink } from '../consts';
const wa = waLink('Hola, quiero la instalación gratis del chatbot de WhatsApp para mi clínica.');
// Offer 1 (the ad's): first 5 clinics get the install free (the case-study permission is agreed in private, not on the page);
// 30-day trial, then the monthly fee, month to month. Offer 2 (after those 5): same trial; the install can be split into the monthly fees if they want.
const PRICE_INSTALL = '$5,000';
const PRICE_MONTH = '$2,500';
const chat = [
  ['out', '¿Cuál es el precio de la limpieza dental?', '9:41'],
  ['in', '¡Hola! 😊 El precio de la limpieza dental es de $900.', '9:42'],
  ['out', 'Quiero agendar una cita.', '9:43'],
  ['in', '¡Listo! Tu cita quedó agendada. ✅', '9:48'],
];
const features = [
  ['Contesta precios', 'Limpieza, blanqueamiento, ortodoncia, resinas: responde al momento con los precios que tú le das.'],
  ['Agenda citas', 'Pregunta día y hora, confirma la cita con el paciente y te avisa para que la tengas en tu agenda.'],
  ['Atiende fuera de horario', 'Noches, fines de semana y días festivos. El paciente que escribe a las 11 p. m. ya no se va con otra clínica.'],
  ['Te pasa lo importante', 'Urgencias, dudas sobre un tratamiento o quejas: te pasa la conversación para que la atienda tu equipo.'],
];
const includes = [
  'En el WhatsApp de tu clínica, mismo número',
  'Cambios de precios y respuestas cuando los necesites',
  'Soporte directo por WhatsApp',
];
const faq = [
  ['¿El chatbot da consejos médicos o diagnósticos?', 'No. Solo da información de tu clínica: precios, horarios, ubicación y citas. Si un paciente pregunta por síntomas, dolor, medicamentos o qué tratamiento necesita, el chatbot no contesta eso: le dice que lo valorará el doctor y te pasa la conversación.'],
  ['¿Funciona con el WhatsApp de mi clínica?', 'Sí. Se conecta a tu número de WhatsApp Business, así tus pacientes te siguen escribiendo al mismo número de siempre.'],
  ['¿Qué pasa con las urgencias o si no sabe la respuesta?', 'Te pasa la conversación para que tu equipo conteste. Ningún paciente se queda sin respuesta.'],
  ['¿Qué incluye la instalación gratis?', `Configuramos el chatbot con tus tratamientos, precios, horarios y ubicación, lo conectamos a tu WhatsApp y lo probamos contigo. Normalmente cuesta ${PRICE_INSTALL}; para las primeras 5 clínicas es gratis.`],
  ['¿Cuándo empiezo a pagar?', `Pruebas el chatbot 30 días sin pagar nada. Si no te gusta, lo dejas ahí. Si te quedas, pagas ${PRICE_MONTH} al mes a partir del día 30.`],
  ['¿Hay contrato o plazo forzoso?', 'No. Si un día ya no lo quieres, lo cancelas.'],
  ['¿Y si ya se llenaron los 5 lugares?', `Igual tienes el primer mes de prueba: si no te gusta, no pagas ni instalación ni mensualidad. Si te quedas, pagas la instalación de ${PRICE_INSTALL} y, si prefieres, la repartimos en tus mensualidades; por ejemplo, $1,000 extra al mes durante 5 meses ($3,500 al mes) y luego ${PRICE_MONTH}.`],
  ['¿Puedo cambiar precios u horarios después?', 'Sí. Nos escribes y lo actualizamos.'],
  ['¿Necesito saber de tecnología?', 'No. Nosotros lo configuramos todo; tú solo nos dices cómo funciona tu clínica.'],
];
// [title, text, WhatsApp link, examples page (optional)]
const services: [string, string, string, string?][] = [
  ['Chatbots', 'Asistentes de WhatsApp para cualquier negocio: restaurantes, inmobiliarias, tiendas.', waLink('Hola, quiero un chatbot de WhatsApp para mi negocio.')],
  ['Automatizaciones', 'Lo que hoy haces a mano, hecho solo: facturas, recordatorios, cotizaciones, reportes.', waLink('Hola, quiero automatizar procesos de mi negocio.')],
  ['MVPs', '¿Tienes una idea que quieres probar o una app que se quedó a medias? La terminamos.', waLink('Hola, tengo un proyecto a medias (o una idea) y quiero terminarlo.')],
  ['Webs', 'Webs a la medida, rápidas en el celular y con WhatsApp a un toque.', waLink('Hola, quiero una web para mi negocio.'), '/webs'],
];
const waIcon = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z';
---
<Base bare title="Chatbot de WhatsApp para clínicas dentales" description="Que ningún paciente se quede sin respuesta en WhatsApp. Un chatbot que contesta precios y agenda citas 24/7. Instalación gratis para las primeras 5 clínicas.">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <div class="landing">
    <header class="top">
      <a href="/" class="logo">Mansfield<span>.</span></a>
      <nav>
        <a href="#funciones">Cómo funciona</a>
        <a href="#precios">Precios</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a href={wa} target="_blank" rel="noopener" class="top-wa">Instalación gratis</a>
    </header>

    <section class="hero">
      <div class="pitch">
        <p class="kicker">Chatbot de WhatsApp para clínicas dentales</p>
        <h1>Que ningún paciente se quede <em>sin respuesta</em> en WhatsApp.</h1>
        <p class="lead"><b>Respuestas en segundos, 24/7.</b><br />Contesta precios y agenda citas mientras tú atiendes pacientes.</p>
        <div class="promo">
          <span class="gift" aria-hidden="true">🎁</span>
          <p><b>Instalación gratis</b> para las primeras <b>5 clínicas</b>.<br />Pruébalo 30 días: si no te gusta, no pagas nada.</p>
        </div>
        <a href={wa} target="_blank" rel="noopener" class="cta">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={waIcon} /></svg>
          Quiero mi instalación gratis
        </a>
      </div>

      <div class="phone" aria-label="Ejemplo: un paciente pregunta el precio de una limpieza y agenda una cita con el chatbot de una clínica dental">
        <div class="screen">
          <div class="bar">
            <span class="avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.5 3C5 3 3.5 5 3.5 7.6c0 2.2 1 3.6 1.6 5.6.6 2 .9 7.8 2.9 7.8 1.6 0 1.6-5.2 4-5.2s2.4 5.2 4 5.2c2 0 2.3-5.8 2.9-7.8.6-2 1.6-3.4 1.6-5.6C20.5 5 19 3 16.5 3c-2 0-3 1.2-4.5 1.2S9.5 3 7.5 3z"/></svg></span>
            <span class="who"><b>Clínica Dental</b><small>En línea</small></span>
          </div>
          <div class="msgs" id="chat">
            {chat.map(([side, text, time]) => (
              <div class:list={['msg', side]}><span>{text}</span><time>{time} a. m.{side === 'out' && <i>✓✓</i>}</time></div>
            ))}
            <div class="msg in typing" aria-hidden="true"><span><b></b><b></b><b></b></span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="block duo" id="funciones">
      <div>
        <h2>Lo que hace por tu clínica</h2>
        <div class="grid feats">
          {features.map(([t, d]) => <div class="card"><h3>{t}</h3><p>{d}</p></div>)}
        </div>
      </div>
      <div id="precios">
        <h2>Precio</h2>
        <div class="plan">
          <div class="plan-head">
            <h3>Chatbot para tu clínica</h3>
            <p class="month"><b>{PRICE_MONTH}</b> MXN / mes<span class="terms"><span class="dot"> · </span>sin plazo forzoso</span></p>
          </div>
          <div class="install">
            <span>Instalación</span>
            <s>{PRICE_INSTALL}</s>
            <b>Gratis</b>
            <small>Solo para las primeras 5 clínicas.</small>
          </div>
          <p class="trial"><b>30 días de prueba.</b> Si no te gusta, no pagas nada.</p>
          <ul>{includes.map((i) => <li>{i}</li>)}</ul>
          <a href={wa} target="_blank" rel="noopener" class="cta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={waIcon} /></svg>
            Quiero mi instalación gratis
          </a>
        </div>
        <p class="next">¿Ya se llenaron los 5 lugares? Igual pruebas el primer mes sin pagar, y si te quedas, puedes repartir la instalación en tus mensualidades.</p>
      </div>
    </section>

    <section class="block" id="preguntas">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="final">
      <h2>¿Cuántos pacientes se te van por no contestar a tiempo?</h2>
      <p>Instalación gratis para las primeras 5 clínicas y 30 días de prueba. Si no te gusta, no pagas nada.</p>
      <a href={wa} target="_blank" rel="noopener" class="cta">Quiero mi instalación gratis</a>
    </section>

    <section class="block others" id="servicios">
      <h2>Otros servicios</h2>
      <div class="grid">
        {services.map(([t, d, ask, examples]) => (
          <div class="card">
            <h3>{t}</h3>
            <p>{d}</p>
            <div class="links">
              <a href={ask} target="_blank" rel="noopener">Preguntar →</a>
              {examples && <a href={examples}>Ver ejemplos →</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  // Replays the hero conversation: each patient message appears, then "typing…", then the bot's answer. Loops.
  const chat = document.getElementById('chat');
  if (chat && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const msgs = [...chat.querySelectorAll<HTMLElement>('.msg:not(.typing)')];
    const typing = chat.querySelector<HTMLElement>('.typing')!;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    chat.classList.add('play');
    (async () => {
      for (;;) {
        msgs.forEach((m) => m.classList.remove('on'));
        await wait(700);
        for (const m of msgs) {
          if (m.classList.contains('in')) {
            chat.insertBefore(typing, m);
            typing.classList.add('on');
            await wait(1300);
            typing.classList.remove('on');
          }
          m.classList.add('on');
          await wait(1100);
        }
        await wait(4000);
      }
    })();
  }
</script>

<style>
  .landing { --ink: #1a1917; --paper: #faf8f3; --muted: #6b665e; --line: #e3ded3; --accent: #c2410c; --green: #1fa855; font-family: Nunito, ui-sans-serif, system-ui, sans-serif; color: var(--ink); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px clamp(20px, 5vw, 64px); }
  .logo { font-size: 22px; font-weight: 500; text-decoration: none; color: var(--ink); }
  .logo span { color: var(--accent); }
  .top nav { display: flex; gap: 28px; margin-left: auto; font-size: 14px; }
  .top nav a { color: var(--muted); text-decoration: none; }
  .top nav a:hover { color: var(--ink); }
  .top-wa { font-size: 14px; font-weight: 500; text-decoration: none; color: var(--ink); border: 1px solid #d9d4c8; border-radius: 999px; padding: 8px 16px; }
  .top-wa:hover { background: var(--ink); color: var(--paper); }

  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: clamp(30px, 5vw, 80px); max-width: 1240px; margin: 0 auto; min-height: calc(100svh - 160px); padding: 20px clamp(20px, 5vw, 64px) 40px; }
  .kicker { font-size: 14px; letter-spacing: 0.02em; color: var(--muted); margin: 0 0 22px; }
  h1 { font-size: clamp(2.4rem, 4.3vw, 4.1rem); line-height: 1.12; letter-spacing: -0.035em; font-weight: 500; margin: 0; }
  /* inline-block: the green box is one piece that never wraps and takes its own height in the line, so it can't cover the line above. */
  h1 em { display: inline-block; white-space: nowrap; font-style: normal; color: #fff; background: #3cc35f; border-radius: 0.18em; padding: 0 0.14em 0.04em; line-height: 1.08; }
  .lead { font-size: 18px; line-height: 1.6; color: #4a463f; max-width: 30em; margin: 24px 0 26px; }
  .lead b { font-size: 22px; font-weight: 500; color: var(--ink); }
  .promo { display: flex; align-items: center; gap: 14px; max-width: 440px; margin: 0 0 26px; padding: 14px 18px; background: #e8f8ec; border: 1px solid #bfe9cb; border-radius: 16px; }
  .promo p { margin: 0; font-size: 17px; line-height: 1.4; color: #0f5a2c; }
  .promo b { font-weight: 700; }
  .gift { font-size: 26px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; background: #25d366; color: #06301a; font-weight: 600; font-size: 17px; text-decoration: none; padding: 16px 26px; border-radius: 999px; box-shadow: 0 12px 30px rgba(37, 211, 102, 0.3); transition: transform 0.2s, box-shadow 0.2s; }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 16px 36px rgba(37, 211, 102, 0.4); }
  .cta svg { width: 22px; height: 22px; }

  /* The phone: a plain CSS frame around a WhatsApp-style chat. */
  .phone { justify-self: center; width: min(320px, 100%, 40svh); aspect-ratio: 9 / 18.5; background: #111; border-radius: 48px; padding: 11px; box-shadow: 0 40px 80px -30px rgba(26, 25, 23, 0.45); }
  .screen { height: 100%; border-radius: 38px; overflow: hidden; background: #efeae2; display: flex; flex-direction: column; }
  .bar { display: flex; align-items: center; gap: 10px; padding: 40px 16px 12px; background: #f7f7f5; border-bottom: 1px solid #e4e1da; }
  .avatar { width: 36px; height: 36px; border-radius: 50%; background: #e3e7ea; color: #8696a0; display: grid; place-items: center; }
  .avatar svg { width: 20px; height: 20px; }
  .who { display: grid; line-height: 1.2; }
  .who b { font-size: 15px; font-weight: 600; }
  .who small { font-size: 12px; color: #667781; }
  .msgs { flex: 1; display: flex; flex-direction: column; gap: 8px; padding: 16px 12px; font-family: -apple-system, "Segoe UI", Roboto, sans-serif; }
  .msg { max-width: 82%; padding: 7px 9px 5px; border-radius: 10px; font-size: 14px; line-height: 1.35; box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08); }
  .msg.out { align-self: flex-end; background: #d9fdd3; border-top-right-radius: 2px; }
  .msg.in { align-self: flex-start; background: #fff; border-top-left-radius: 2px; }
  .msg time { display: block; text-align: right; font-size: 10.5px; color: #667781; margin-top: 2px; }
  .msg time i { font-style: normal; color: #53bdeb; margin-left: 4px; letter-spacing: -3px; }
  .typing { display: none; }
  .typing span { display: flex; gap: 4px; padding: 4px 2px; }
  .typing b { width: 6px; height: 6px; border-radius: 50%; background: #8696a0; animation: dot 1s infinite; }
  .typing b:nth-child(2) { animation-delay: 0.15s; }
  .typing b:nth-child(3) { animation-delay: 0.3s; }
  @keyframes dot { 0%, 60%, 100% { opacity: 0.3; transform: none; } 30% { opacity: 1; transform: translateY(-2px); } }
  /* With JS (and motion allowed) messages start hidden and the script reveals them one by one. */
  .msgs.play .msg { display: none; }
  .msgs.play .msg.on { display: block; animation: pop 0.25s ease-out; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px); } }

  .block { max-width: 1200px; margin: 0 auto; padding: 72px clamp(20px, 5vw, 64px) 0; }
  .block h2, .final h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; margin: 0 0 24px; }
  /* What it does (2×2 cards) and the price side by side. */
  .duo { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .grid.feats { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; gap: 8px; padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 18px; }
  .card h3 { font-size: 18px; font-weight: 600; margin: 0; }
  .card p { margin: 0; font-size: 15px; line-height: 1.5; color: #5a554d; }
  .links { margin-top: auto; padding-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .links a { font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .links a:hover { color: var(--green); }

  .plan { padding: 26px; background: #fff; border: 1px solid var(--line); border-radius: 20px; display: grid; gap: 16px; }
  .plan-head h3 { font-size: 18px; font-weight: 600; margin: 0 0 4px; }
  .month { margin: 0; font-size: 16px; color: var(--muted); }
  .month b { font-size: 36px; font-weight: 600; letter-spacing: -0.03em; color: var(--ink); }
  .install { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 16px 18px; background: #e8f8ec; border: 1px solid #bfe9cb; border-radius: 14px; color: #0f5a2c; }
  .install span { font-weight: 600; }
  .install s { color: #6b8f78; }
  .install b { font-size: 22px; font-weight: 700; color: var(--green); }
  .install small { flex-basis: 100%; font-size: 14px; line-height: 1.45; }
  .trial { margin: 0; line-height: 1.5; color: #4a463f; }
  .trial b { color: var(--ink); font-weight: 600; }
  .next { margin: 14px 0 0; font-size: 15px; line-height: 1.55; color: var(--muted); }
  .plan ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 15px; }
  .plan li { line-height: 1.45; }
  .plan li::before { content: '✓'; color: var(--green); margin-right: 10px; }
  .plan .cta { justify-self: start; }

  .faq { border-top: 1px solid var(--line); max-width: 820px; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; font-size: 17px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--muted); font-size: 22px; line-height: 1; transition: transform 0.2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { margin: -6px 0 22px; line-height: 1.6; color: #4a463f; max-width: 40em; }

  .final { margin: 80px clamp(20px, 5vw, 64px) 0; padding: clamp(40px, 6vw, 64px) clamp(24px, 6vw, 80px); background: var(--ink); color: var(--paper); border-radius: 28px; text-align: center; }
  .final h2 { max-width: 16em; margin: 0 auto 18px; }
  .final p { color: #b9b3a8; font-size: 18px; line-height: 1.6; margin: 0 auto 34px; max-width: 30em; }

  .others { padding-bottom: 80px; }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .top nav { display: none; }
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; padding-top: 10px; }
    .phone { width: min(300px, 100%); }
    .block { padding-top: 56px; }
    .duo { grid-template-columns: minmax(0, 1fr); }
  }
  .terms { white-space: nowrap; }
  /* Phones: smaller hero phone, cards two per row and compact, full-width buttons that fit on one line. */
  @media (max-width: 560px) {
    .phone { width: 240px; border-radius: 40px; padding: 9px; }
    .screen { border-radius: 32px; }
    .bar { padding-top: 30px; }
    .msg { font-size: 13px; }
    .cta { justify-content: center; font-size: 16px; padding: 15px 20px; }
    .pitch .cta, .plan .cta { width: 100%; justify-self: stretch; }
    .grid, .grid.feats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .card { padding: 16px 14px; gap: 6px; }
    .card h3 { font-size: 16px; }
    .card p { font-size: 13.5px; }
    .plan { padding: 20px; }
    .terms { display: block; margin-top: 2px; }
    .dot { display: none; }
    .final { margin-top: 56px; }
    .others { padding-bottom: 56px; }
  }
</style>
