---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <div class="flex flex-col items-center text-center">
    <p class="eyebrow mt-8 sm:mt-16">404</p>
    <h1 class="serif mt-3 text-4xl tracking-tight sm:text-5xl">Lost in the empty space.</h1>
    <p class="mt-4 text-stone-600 dark:text-stone-400">This page doesn't exist (or I moved it).</p>
    <a href="/" class="mt-7 inline-block rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition hover:bg-accent dark:bg-stone-100 dark:text-night">Back home →</a>
  </div>
</Base>
