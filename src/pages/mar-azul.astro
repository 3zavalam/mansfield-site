---
// Demo: Hotel Mar Azul, a boutique hotel in Tulum (fictional). Render: the Caribbean at sunrise, a wave shader
// with the sun's path glittering on the water. Suites and location use photos.
// Photos: Unsplash (free licence), ids 67-sOi7mVIk, baRMLxJOrmU, XWi8UGsCXas, vxWWlATeUK4, ldjD3OzWJPA.
import Demo from '../layouts/Demo.astro';
import { pic } from '../demos/pic';
const rooms = [
  ['Suite Jardín', 'Terraza privada entre palmas y un baño a cielo abierto.', '4,800', 'jardin'],
  ['Suite Mar', 'Frente al mar, con hamaca y regadera exterior.', '7,200', 'suite-mar'],
  ['Casa Cenote', 'Dos recámaras y alberca propia de agua de cenote.', '12,500', 'cenote'],
];
---
<Demo title="Hotel Mar Azul · Tulum" description="Hotel boutique de 14 suites frente al mar en Tulum." fonts="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" bg="#f6f1ea" color="#13324a">
  <div class="mar">
    <section class="hero">
      <div class="sky"></div>
      <div class="sun" id="mar-sun"></div>
      <canvas id="mar-gl" aria-label="El mar al amanecer"></canvas>
      <header class="nav">
        <nav><a href="#suites">Suites</a><a href="#experiencias">Experiencias</a></nav>
        <a href="#" class="logo">Mar Azul<small>HOTEL · TULUM</small></a>
        <nav class="r"><a href="#ubicacion">Ubicación</a><a href="#reservar">Reservar</a></nav>
      </header>
      <div class="copy">
        <h1>Tulum, <em>sin prisa.</em></h1>
        <p>Catorce suites entre la selva y el mar Caribe.</p>
      </div>
      <form class="book" id="reservar" onsubmit="return false">
        <label>Llegada<input type="date" /></label>
        <label>Salida<input type="date" /></label>
        <label>Huéspedes<select><option>2 adultos</option><option>2 adultos, 1 niño</option><option>4 adultos</option></select></label>
        <button type="submit">Ver disponibilidad</button>
      </form>
    </section>

    <section class="intro">
      <p>Un hotel pequeño a propósito. Sin ruido, sin pantallas en las habitaciones, con desayuno servido en la arena y el mar a doce pasos de tu cama.</p>
    </section>

    <section id="suites" class="suites">
      {rooms.map(([n, d, p, k]) => (
        <article>
          <div class="pic"><img {...pic(`/img/demos/mar/${k}`, '(max-width: 900px) 100vw, 33vw')} alt={n} /></div>
          <h3>{n}</h3>
          <p>{d}</p>
          <p class="price">desde <b>${p}</b> MXN / noche</p>
        </article>
      ))}
    </section>

    <section id="experiencias" class="exp">
      <div>
        <h2>Experiencias</h2>
        <img {...pic('/img/demos/mar/andador', '(max-width: 900px) 100vw, 420px')} alt="Andador de madera entre palapas y palmeras" />
      </div>
      <ul>
        <li><span>06:00</span>Yoga al amanecer frente al mar</li>
        <li><span>10:00</span>Nado en el cenote Calavera</li>
        <li><span>13:00</span>Comida maya con cocineras de Cobá</li>
        <li><span>18:30</span>Temazcal en la selva</li>
        <li><span>21:00</span>Cena bajo las estrellas</li>
      </ul>
    </section>

    <section id="ubicacion" class="loc">
      <img {...pic('/img/demos/mar/playa')} alt="Una palmera sola en la playa al amanecer" />
      <h2>Carretera Tulum–Boca Paila km 7.5</h2>
      <p>A 35 minutos del aeropuerto de Tulum. Te recogemos sin costo.</p>
    </section>
    <footer><span>Hotel Mar Azul © 2026</span><span>reservas@hotelmarazul.mx · +52 984 123 4567</span></footer>
  </div>
</Demo>

<script>
  import * as THREE from 'three';
  import { stage } from '../demos/stage';

  const sunDir = new THREE.Vector3(0, 0.12, -1).normalize();
  const uniforms = {
    uTime: { value: 0 },
    uSun: { value: sunDir },
    uDeep: { value: new THREE.Color('#0d4a63') },
    uShallow: { value: new THREE.Color('#2b8ea3') },
    uSky: { value: new THREE.Color('#f3cfae') },
    uHorizon: { value: new THREE.Color('#f5c9a4') },
  };
  const water = new THREE.Mesh(new THREE.PlaneGeometry(320, 320, 260, 260), new THREE.ShaderMaterial({
    uniforms,
    vertexShader: /* glsl */ `
      uniform float uTime; varying vec3 vPos; varying vec3 vN;
      float h(vec2 p) {
        return 0.32 * sin(p.x * 0.16 + uTime * 0.8) + 0.24 * sin(p.y * 0.21 + uTime * 1.0)
             + 0.11 * sin((p.x + p.y) * 0.47 + uTime * 1.6) + 0.05 * sin((p.x * 0.9 - p.y * 1.3) * 1.2 + uTime * 2.2)
             + 0.025 * sin((p.x * 2.1 + p.y * 1.7) * 1.4 + uTime * 3.1);
      }
      void main() {
        vec3 p = (modelMatrix * vec4(position, 1.0)).xyz;
        float e = 0.15;
        vN = normalize(vec3(h(p.xz - vec2(e, 0.)) - h(p.xz + vec2(e, 0.)), 2.0 * e, h(p.xz - vec2(0., e)) - h(p.xz + vec2(0., e))));
        p.y += h(p.xz);
        vPos = p;
        gl_Position = projectionMatrix * viewMatrix * vec4(p, 1.0);
      }`,
    fragmentShader: /* glsl */ `
      uniform vec3 uSun, uDeep, uShallow, uSky, uHorizon; varying vec3 vPos; varying vec3 vN;
      void main() {
        vec3 v = normalize(cameraPosition - vPos), n = normalize(vN);
        float f = pow(1.0 - max(dot(n, v), 0.0), 4.0);
        vec3 col = mix(uDeep, uShallow, clamp(n.y * 0.6 - 0.1 + (1.0 - f) * 0.2, 0.0, 1.0));
        col = mix(col, uSky, f * 0.6);
        vec3 r = reflect(-v, n);
        float s = pow(max(dot(r, normalize(uSun)), 0.0), 220.0) * 3.0 + pow(max(dot(r, normalize(uSun)), 0.0), 18.0) * 0.22;
        col += vec3(1.0, 0.82, 0.58) * s;
        float d = length(vPos.xz - cameraPosition.xz);
        col = mix(col, uHorizon, smoothstep(30.0, 150.0, d));
        gl_FragColor = vec4(col, 1.0);
        #include <colorspace_fragment>
      }`,
  }));
  water.rotation.x = -Math.PI / 2;
  const sunEl = document.getElementById('mar-sun')!;
  const v = new THREE.Vector3();
  const s = stage(document.getElementById('mar-gl') as HTMLCanvasElement, { fov: 45, env: false }, (t, s) => {
    uniforms.uTime.value = t;
    s.camera.position.set(s.pointer.x * 0.6, 2.4 - s.pointer.y * 0.3, 12);
    s.camera.lookAt(0, 1.4, -60);
    // Keep the CSS sun sitting on the shader's horizon.
    v.set(0, 9, -150).project(s.camera);
    sunEl.style.top = `${((1 - v.y) / 2) * 100}%`;
  });
  s.scene.add(water);
</script>

<style>
  .mar { font-family: Jost, sans-serif; font-weight: 300; --blue: #13324a; --sand: #f6f1ea; }
  h1, h2, h3, .logo, .intro p { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 400; }
  em { font-style: italic; }
  .hero { position: relative; height: 100vh; min-height: 640px; overflow: hidden; color: #fff; display: flex; flex-direction: column; }
  .sky { position: absolute; inset: 0; background: linear-gradient(180deg, #7fa6bf 0%, #b8c4c6 28%, #ecd0b1 48%, #f5c9a4 56%); }
  .sun { position: absolute; left: 50%; width: 120px; height: 120px; border-radius: 50%; transform: translate(-50%, -50%); background: radial-gradient(circle, #fffaf0 0%, #ffe7c2 35%, rgba(255, 214, 160, 0.5) 55%, rgba(255, 200, 150, 0) 72%); filter: blur(1px); }
  .hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nav { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 26px clamp(20px, 5vw, 64px); font-size: 13px; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 400; }
  .nav nav { display: flex; gap: 34px; }
  .nav nav.r { justify-content: flex-end; }
  .nav a { text-decoration: none; }
  .logo { display: grid; justify-items: center; font-size: 34px; text-transform: none; letter-spacing: 0.02em; line-height: 1; }
  .logo small { font-family: Jost, sans-serif; font-size: 10px; letter-spacing: 0.4em; margin-top: 6px; }
  .copy { position: relative; z-index: 1; text-align: center; margin-top: 7vh; padding: 0 20px; text-shadow: 0 2px 30px rgba(80, 60, 40, 0.25); }
  h1 { font-size: clamp(3.6rem, 9vw, 8.6rem); line-height: 1; margin: 0; letter-spacing: -0.01em; }
  .copy p { font-size: 18px; letter-spacing: 0.06em; margin: 10px 0 0; }
  .book { position: absolute; z-index: 1; left: 50%; bottom: 40px; transform: translateX(-50%); display: grid; grid-template-columns: repeat(3, 1fr) auto; gap: 0; background: rgba(246, 241, 234, 0.92); backdrop-filter: blur(14px); color: var(--blue); width: min(900px, calc(100% - 40px)); }
  .book label { display: grid; gap: 4px; padding: 14px 20px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; border-right: 1px solid rgba(19, 50, 74, 0.15); }
  .book input, .book select { border: 0; background: transparent; font-size: 15px; padding: 0; letter-spacing: 0; text-transform: none; }
  .book button { background: var(--blue); color: var(--sand); border: 0; padding: 0 28px; text-transform: uppercase; letter-spacing: 0.16em; font-size: 12px; cursor: pointer; }

  .intro { padding: 130px clamp(20px, 10vw, 180px); text-align: center; }
  .intro p { font-size: clamp(1.7rem, 3.2vw, 2.8rem); line-height: 1.3; margin: 0 auto; max-width: 24em; }
  .suites { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; padding: 0 clamp(20px, 5vw, 64px) 120px; max-width: 1360px; margin: 0 auto; }
  .pic { aspect-ratio: 3 / 4; border-radius: 200px 200px 0 0; position: relative; overflow: hidden; }
  .pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s; }
  article:hover .pic img { transform: scale(1.05); }
  .suites h3 { font-size: 34px; margin: 22px 0 6px; }
  .suites p { line-height: 1.6; margin: 0; }
  .price { margin-top: 12px !important; font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; }
  .price b { font-weight: 500; }

  .exp { background: var(--blue); color: var(--sand); padding: 110px clamp(20px, 5vw, 64px); display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; }
  h2 { font-size: clamp(2.6rem, 5vw, 4.6rem); margin: 0; line-height: 1.05; }
  .exp ul { list-style: none; margin: 0; padding: 0; }
  .exp img { margin-top: 40px; width: 100%; max-width: 420px; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 0 160px 0 0; }
  .exp li { display: flex; gap: 30px; padding: 22px 0; border-bottom: 1px solid rgba(246, 241, 234, 0.2); font-family: "Cormorant Garamond", serif; font-size: 26px; }
  .exp li span { font-family: Jost, sans-serif; font-size: 13px; letter-spacing: 0.15em; opacity: 0.7; padding-top: 10px; min-width: 50px; }
  .loc { position: relative; isolation: isolate; padding: 200px clamp(20px, 5vw, 64px); text-align: center; color: #fff; overflow: hidden; }
  .loc img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; filter: brightness(0.78); }
  .loc h2 { text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3); }
  .loc p { margin-top: 16px; }
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 26px clamp(20px, 5vw, 64px) 70px; border-top: 1px solid rgba(19, 50, 74, 0.15); font-size: 13px; letter-spacing: 0.06em; }

  @media (max-width: 900px) {
    .nav { grid-template-columns: 1fr; justify-items: center; }
    .nav nav { display: none; }
    .book { grid-template-columns: 1fr 1fr; }
    .book button { grid-column: 1 / -1; padding: 16px; }
    .suites, .exp { grid-template-columns: 1fr; }
  }
</style>
