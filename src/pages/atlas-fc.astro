---
// Demo: Atlas FC, a youth football academy (fictional). Render: a 3D pitch where the yellow team plays
// a passing move against a back line, with the ball's path traced in light.
import Demo from '../layouts/Demo.astro';
const cats = [
  ['Sub-8', 'Iniciación', 'Lun · Mié', '16:00'], ['Sub-10', 'Fundamentos', 'Lun · Mié · Vie', '16:30'],
  ['Sub-12', 'Juego colectivo', 'Mar · Jue · Vie', '17:00'], ['Sub-15', 'Competencia', 'Mar · Jue · Sáb', '18:00'],
  ['Sub-17', 'Alto rendimiento', 'Lun a Vie', '18:30'], ['Porteros', 'Especialización', 'Mar · Jue', '17:30'],
];
const games = [['SÁB 08', 'Atlas FC', 'Tuzos Academia', 'Sub-15', '10:00'], ['SÁB 08', 'Atlas FC', 'Real Bajío', 'Sub-12', '12:00'], ['DOM 09', 'Deportivo Norte', 'Atlas FC', 'Sub-17', '11:00']];
---
<Demo title="Atlas FC · Academia de fútbol" description="Academia de fútbol en Querétaro. Formamos jugadores de 6 a 17 años." fonts="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&display=swap" bg="#0b1f3a" color="#ffffff">
  <div class="atlas">
    <section class="hero">
      <canvas id="atlas-gl" aria-label="Cancha con una jugada de pases"></canvas>
      <header class="nav">
        <a href="#" class="logo"><span class="crest">A</span>ATLAS FC</a>
        <nav><a href="#categorias">Categorías</a><a href="#metodo">Método</a><a href="#partidos">Partidos</a></nav>
        <a href="#prueba" class="btn">Clase de prueba</a>
      </header>
      <div class="copy">
        <p class="kicker">Academia · Querétaro</p>
        <h1>FORMAMOS<br /><span>JUGADORES.</span></h1>
        <p class="lead">Entrenamiento con metodología de club profesional para niños y jóvenes de 6 a 17 años.</p>
        <a href="#prueba" class="btn big">Agenda una clase gratis</a>
      </div>
      <ul class="stats">
        <li><b>12</b>categorías</li><li><b>340</b>jugadores</li><li><b>27</b>jugadores en fuerzas básicas profesionales</li><li><b>3</b>campos de pasto natural</li>
      </ul>
    </section>

    <section id="categorias" class="cats">
      <h2>CATEGORÍAS</h2>
      <div class="grid">
        {cats.map(([c, d, days, h]) => (
          <article><b>{c}</b><span>{d}</span><div><span>{days}</span><span>{h}</span></div></article>
        ))}
      </div>
    </section>

    <section id="metodo" class="method">
      <h2>EL MÉTODO <span>ATLAS</span></h2>
      <div class="pillars">
        <div><i>01</i><b>Técnica</b><p>Mil toques por sesión. El balón es el centro de cada ejercicio.</p></div>
        <div><i>02</i><b>Táctica</b><p>Juego posicional desde Sub-10: entender el espacio antes que correr.</p></div>
        <div><i>03</i><b>Físico</b><p>Preparación por edad, con medición GPS en las categorías mayores.</p></div>
        <div><i>04</i><b>Persona</b><p>Seguimiento escolar y psicología deportiva para cada jugador.</p></div>
      </div>
    </section>

    <section id="partidos" class="games">
      <h2>PRÓXIMOS PARTIDOS</h2>
      {games.map(([d, h, a, c, t]) => (
        <div class="game"><span class="date">{d}</span><span class="teams"><b class:list={[h === 'Atlas FC' && 'us']}>{h}</b> vs <b class:list={[a === 'Atlas FC' && 'us']}>{a}</b></span><span class="cat">{c}</span><span class="t">{t}</span></div>
      ))}
    </section>

    <section id="prueba" class="trial">
      <h2>LA PRIMERA CLASE<br /><span>VA POR NOSOTROS.</span></h2>
      <form onsubmit="return false"><input placeholder="Nombre del jugador" /><select><option>Edad</option><option>6 – 8</option><option>9 – 12</option><option>13 – 17</option></select><button class="btn big">Apartar lugar</button></form>
    </section>
    <footer><span>Atlas FC © 2026</span><span>Unidad Deportiva Norte, Querétaro</span></footer>
  </div>
</Demo>

<script>
  import * as THREE from 'three';
  import { stage } from '../demos/stage';

  // Pitch: 105 × 68 m at 1:5.
  const L = 21, Wd = 13.6;
  const tc = document.createElement('canvas');
  tc.width = 2100; tc.height = 1360;
  const g = tc.getContext('2d')!;
  for (let i = 0; i < 14; i++) { g.fillStyle = i % 2 ? '#2f7d3f' : '#358a46'; g.fillRect((i * 2100) / 14, 0, 2100 / 14 + 1, 1360); }
  g.strokeStyle = 'rgba(255,255,255,.85)'; g.lineWidth = 6;
  const m = 20; // px per metre
  g.strokeRect(0 + 3, 3, 2094, 1354);
  g.beginPath(); g.moveTo(1050, 0); g.lineTo(1050, 1360); g.stroke();
  g.beginPath(); g.arc(1050, 680, 9.15 * m, 0, Math.PI * 2); g.stroke();
  for (const side of [0, 1]) {
    const x = side ? 2100 : 0, dir = side ? -1 : 1;
    g.strokeRect(side ? x - 16.5 * m : x, 680 - 20.16 * m, 16.5 * m, 40.32 * m);
    g.strokeRect(side ? x - 5.5 * m : x, 680 - 9.16 * m, 5.5 * m, 18.32 * m);
    g.beginPath(); g.arc(x + dir * 11 * m, 680, 9.15 * m, side ? Math.PI * 0.7 : -Math.PI * 0.3, side ? Math.PI * 1.3 : Math.PI * 0.3); g.stroke();
  }
  const tex = new THREE.CanvasTexture(tc);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.anisotropy = 8;

  // Formations in pitch fractions (x: -1 own goal → 1 their goal).
  const yellow = [[-0.92, 0], [-0.55, -0.62], [-0.6, -0.22], [-0.6, 0.22], [-0.55, 0.62], [-0.15, -0.35], [-0.25, 0], [-0.15, 0.35], [0.3, -0.6], [0.38, 0], [0.3, 0.6]];
  const white = [[0.93, 0], [0.55, -0.55], [0.58, -0.18], [0.58, 0.18], [0.55, 0.55], [0.22, -0.4], [0.2, 0], [0.22, 0.4], [-0.05, -0.5], [-0.02, 0.1], [-0.05, 0.5]];
  const moves = [2, 6, 5, 8, 7, 10, 9, 6, 3, 7, 8, 9];
  const at = (f: number[]) => new THREE.Vector3((f[0] * L) / 2, 0, (f[1] * Wd) / 2);

  const players: { mesh: THREE.Group; home: THREE.Vector3; team: number }[] = [];
  const ball = new THREE.Mesh(new THREE.SphereGeometry(0.17, 24, 16), new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0xffffff, emissiveIntensity: 0.4 }));
  const TRAIL = 60;
  const trailGeo = new THREE.BufferGeometry().setAttribute('position', new THREE.BufferAttribute(new Float32Array(TRAIL * 3), 3));
  const trail = new THREE.Line(trailGeo, new THREE.LineBasicMaterial({ color: 0xf2c230, transparent: true, opacity: 0.9 }));
  const trailPts: THREE.Vector3[] = [];
  const s = stage(document.getElementById('atlas-gl') as HTMLCanvasElement, { fov: 32, shadows: true, exposure: 1.05 }, (t, s) => {
    const PASS = 1.15, k = t / PASS, i = Math.floor(k) % moves.length, f = k % 1, e = f * f * (3 - 2 * f);
    const a = players[moves[i]].mesh.position, b = players[moves[(i + 1) % moves.length]].mesh.position;
    ball.position.lerpVectors(a, b, e);
    ball.position.y = 0.17 + Math.sin(f * Math.PI) * (i % 3 === 2 ? 1.6 : 0.25);
    trailPts.push(ball.position.clone());
    if (trailPts.length > TRAIL) trailPts.shift();
    const arr = trailGeo.attributes.position.array as Float32Array;
    for (let j = 0; j < TRAIL; j++) { const p = trailPts[Math.min(j, trailPts.length - 1)] ?? ball.position; arr[j * 3] = p.x; arr[j * 3 + 1] = p.y; arr[j * 3 + 2] = p.z; }
    trailGeo.attributes.position.needsUpdate = true;
    // Everyone shifts a little toward the ball, like a team moving as a block.
    players.forEach((p, j) => {
      const pull = p.team ? 0.12 : 0.08;
      p.mesh.position.x = p.home.x + (ball.position.x - p.home.x) * pull + Math.sin(t * 0.9 + j) * 0.12;
      p.mesh.position.z = p.home.z + (ball.position.z - p.home.z) * pull + Math.cos(t * 0.7 + j) * 0.12;
    });
    const orbit = Math.sin(t * 0.07) * 0.35 + s.pointer.x * 0.15;
    s.camera.position.set(Math.sin(orbit) * 18, 13.5 - s.pointer.y, Math.cos(orbit) * 18);
    s.camera.lookAt(1.2, 0, 0.6);
  });
  const pitch = new THREE.Mesh(new THREE.PlaneGeometry(L + 2, Wd + 2), new THREE.MeshStandardMaterial({ color: 0x2a6f38, roughness: 1 }));
  pitch.rotation.x = -Math.PI / 2;
  pitch.position.y = -0.01;
  pitch.receiveShadow = true;
  const lines = new THREE.Mesh(new THREE.PlaneGeometry(L, Wd), new THREE.MeshStandardMaterial({ map: tex, roughness: 0.95 }));
  lines.rotation.x = -Math.PI / 2;
  lines.receiveShadow = true;
  s.scene.add(pitch, lines, ball, trail);
  const disc = new THREE.CylinderGeometry(0.32, 0.32, 0.14, 32);
  const body = new THREE.CapsuleGeometry(0.2, 0.5, 6, 16);
  const mats = [new THREE.MeshStandardMaterial({ color: 0xf2c230, roughness: 0.4 }), new THREE.MeshStandardMaterial({ color: 0xf2f4f8, roughness: 0.4 })];
  const kits = [new THREE.MeshStandardMaterial({ color: 0x0b1f3a, roughness: 0.6 }), new THREE.MeshStandardMaterial({ color: 0xc8202f, roughness: 0.6 })];
  [yellow, white].forEach((team, ti) => team.forEach((f) => {
    const p = new THREE.Group();
    const d = new THREE.Mesh(disc, mats[ti]);
    d.position.y = 0.07;
    const b = new THREE.Mesh(body, ti ? kits[1] : mats[0]);
    b.position.y = 0.6;
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.15, 16, 12), ti ? mats[1] : kits[0]);
    head.position.y = 1.1;
    for (const o of [d, b, head]) { o.castShadow = true; p.add(o); }
    const home = at(f);
    p.position.copy(home);
    s.scene.add(p);
    players.push({ mesh: p, home, team: ti });
  }));
  const sun = new THREE.DirectionalLight(0xffffff, 2.4);
  sun.position.set(-8, 16, 6);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  Object.assign(sun.shadow.camera, { left: -14, right: 14, top: 10, bottom: -10 });
  s.scene.add(sun, new THREE.HemisphereLight(0xbfd8ff, 0x1e3b22, 0.9));
</script>

<style>
  .atlas { font-family: Barlow, sans-serif; --navy: #0b1f3a; --gold: #f2c230; }
  h1, h2, .logo, b, .kicker { font-family: Anton, Impact, sans-serif; font-weight: 400; }
  .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: radial-gradient(ellipse at 70% 60%, #143563, var(--navy) 70%); }
  .hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11, 31, 58, 0.95) 0%, rgba(11, 31, 58, 0.6) 38%, rgba(11, 31, 58, 0) 62%); pointer-events: none; }
  .nav, .copy, .stats { position: relative; z-index: 1; }
  .nav { display: flex; align-items: center; justify-content: space-between; padding: 22px clamp(20px, 5vw, 64px); }
  .logo { display: flex; align-items: center; gap: 12px; font-size: 26px; letter-spacing: 0.04em; text-decoration: none; }
  .crest { width: 40px; height: 46px; display: grid; place-items: center; background: var(--gold); color: var(--navy); clip-path: polygon(0 0, 100% 0, 100% 70%, 50% 100%, 0 70%); font-size: 24px; }
  .nav nav { display: flex; gap: 30px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; font-size: 14px; }
  .nav nav a { text-decoration: none; }
  .btn { background: var(--gold); color: var(--navy); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none; padding: 12px 20px; border: 0; cursor: pointer; font-size: 14px; clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .btn.big { padding: 18px 32px; font-size: 16px; }
  .copy { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 0 clamp(20px, 5vw, 64px); }
  .kicker { color: var(--gold); letter-spacing: 0.2em; font-size: 16px; margin: 0; }
  h1 { font-size: clamp(4rem, 11vw, 11rem); line-height: 0.88; margin: 14px 0 0; letter-spacing: 0.01em; }
  h1 span { color: var(--gold); }
  .lead { font-size: 19px; line-height: 1.5; max-width: 26em; opacity: 0.85; margin: 22px 0 30px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, 0.15); background: rgba(11, 31, 58, 0.6); backdrop-filter: blur(8px); }
  .stats li { padding: 20px clamp(20px, 3vw, 40px); border-right: 1px solid rgba(255, 255, 255, 0.15); font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.85; }
  .stats b { display: block; font-size: 44px; color: var(--gold); letter-spacing: 0; }

  .cats, .method, .games { padding: 100px clamp(20px, 5vw, 64px); max-width: 1300px; margin: 0 auto; }
  h2 { font-size: clamp(2.8rem, 6vw, 5.6rem); line-height: 0.95; margin: 0 0 44px; }
  h2 span { color: var(--gold); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: rgba(255, 255, 255, 0.12); border: 2px solid rgba(255, 255, 255, 0.12); }
  article { background: var(--navy); padding: 30px; display: flex; flex-direction: column; gap: 4px; transition: background 0.2s; }
  article:hover { background: var(--gold); color: var(--navy); }
  article b { font-size: 48px; }
  article > span { text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; opacity: 0.75; }
  article div { display: flex; justify-content: space-between; margin-top: 26px; font-weight: 600; }
  .pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .pillars i { font-style: normal; font-family: Anton, sans-serif; color: var(--gold); font-size: 20px; }
  .pillars b { display: block; font-size: 34px; margin: 14px 0 10px; text-transform: uppercase; }
  .pillars p { line-height: 1.55; opacity: 0.8; margin: 0; }
  .game { display: grid; grid-template-columns: 110px 1fr 100px 80px; align-items: center; gap: 20px; padding: 22px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.15); font-size: 18px; }
  .date { font-family: Anton, sans-serif; color: var(--gold); font-size: 22px; }
  .teams b { font-family: Barlow, sans-serif; font-weight: 700; }
  .teams b.us { color: var(--gold); }
  .cat { text-transform: uppercase; font-weight: 600; font-size: 14px; opacity: 0.7; }
  .t { text-align: right; font-weight: 700; }
  .trial { background: var(--gold); color: var(--navy); padding: 100px clamp(20px, 5vw, 64px); }
  .trial h2 span { color: #fff; -webkit-text-stroke: 2px var(--navy); }
  .trial form { display: flex; gap: 10px; flex-wrap: wrap; }
  .trial input, .trial select { border: 2px solid var(--navy); background: transparent; padding: 16px 18px; font-weight: 600; min-width: 220px; }
  .trial .btn { background: var(--navy); color: var(--gold); }
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 26px clamp(20px, 5vw, 64px) 70px; font-size: 14px; opacity: 0.7; }

  @media (max-width: 900px) {
    .nav nav { display: none; }
    .stats, .pillars { grid-template-columns: 1fr 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
    .game { grid-template-columns: 80px 1fr; }
    .cat, .t { display: none; }
    .hero::after { background: linear-gradient(180deg, rgba(11, 31, 58, 0.3), rgba(11, 31, 58, 0.9)); }
  }
</style>
