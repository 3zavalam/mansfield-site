---
// /personal: two cards up top (analyses published, goals: click one for its dates), then life in weeks up to 90.
// The weeks are drawn at build time and redrawn in the browser so the count is always today's.
import Base from '../layouts/Base.astro';
import { getPosts } from '../posts';
import { GOALS, EVENTS, YEARS, WEEKS_PER_YEAR, CELL, BOX, DIP_ME, lifeWeeks, squares, weekOf } from '../personal';
const posts = await getPosts();
const latest = posts[0];
const target = GOALS.find((g) => g.analyses);
const { total, lived, pct } = lifeWeeks();
const W = WEEKS_PER_YEAR * CELL, H = YEARS * CELL;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const n = (x: number) => x.toLocaleString('en-US');

// Goals: open ones in their order, then done ones, newest first. Each drops down to its dates and a timeline
// from when it was set to the deadline (today's position on it is set in the browser).
const open = GOALS.filter((g) => !g.done);
const done = GOALS.filter((g) => g.done).sort((a, b) => b.done!.localeCompare(a.done!));
const goals = [...open, ...done];
const day = (iso: string) => fmt(new Date(iso));
const DAY = 24 * 60 * 60 * 1000;
const span = (from: string, to: string) => {
  const months = Math.round((new Date(to).getTime() - new Date(from).getTime()) / DAY / 30.44);
  const y = Math.floor(months / 12), m = months % 12;
  return [y && `${y} yr${y > 1 ? 's' : ''}`, m && `${m} mo`].filter(Boolean).join(' ') || 'under a month';
};
---
<Base title="Personal">
  <h1 class="sr-only">Personal</h1>

  {/* Pulled up under the header (the layout's top padding is cancelled here). */}
  <div class="-mt-6 grid items-start sm:-mt-10 gap-4 sm:grid-cols-[1fr_1.6fr]">
    {/* Analyses published */}
    <a href="/analysis" class="card group flex flex-col">
      <p class="eyebrow">Analyses published</p>
      <p class="mt-3 text-6xl font-semibold leading-none tabular-nums">{posts.length}{target && <span class="text-2xl font-medium text-stone-400 dark:text-stone-500"> / {target.analyses}</span>}</p>
      {target && (
        <div class="mt-4">
          <div class="progress" role="progressbar" aria-valuemin={0} aria-valuemax={target.analyses} aria-valuenow={posts.length} aria-label={`${posts.length} of ${target.analyses} analyses`}>
            <span style={`width:${Math.min(100, (posts.length / target.analyses!) * 100)}%`}></span>
          </div>
          <p class="mono mt-1.5 text-[12px] text-stone-500 dark:text-stone-400">Goal: {target.analyses} by {target.when.replace(/^End of /, 'the end of ')}</p>
        </div>
      )}
      {latest && (
        <p class="mt-auto pt-6 text-sm leading-snug text-stone-500 dark:text-stone-400">
          Latest: <span class="font-semibold text-ink transition-colors group-hover:text-accent dark:text-stone-100 dark:group-hover:text-accent-dark">{latest.data.title}</span>
          <span class="mono block pt-0.5 text-[12px]">{fmt(latest.data.date)}</span>
        </p>
      )}
    </a>

    {/* Goals: open or done (tabs), in a card that never grows past a few rows (it scrolls inside instead),
        so more goals or an opened one don't push the page down. One drops down at a time. */}
    <div class="card">
      <div class="flex items-baseline justify-between gap-3">
        <p class="eyebrow">Goals</p>
        <div class="tabs" role="tablist">
          <button type="button" role="tab" class="tab" data-tab="open" aria-selected="true">Open <span class="mono">{open.length}</span></button>
          <button type="button" role="tab" class="tab" data-tab="done" aria-selected="false">Done <span class="mono">{done.length}</span></button>
        </div>
      </div>
      {[['open', open], ['done', done]].map(([key, list]) => (
        <ul class="goals mt-2" data-list={key} hidden={key !== 'open'}>
          {(list as typeof goals).map((g) => (
            <li class="border-b border-dotted border-stone-300 last:border-0 dark:border-stone-700">
              <details class="goal" name="goal">
                <summary class="flex cursor-pointer list-none items-baseline gap-3 py-2">
                  <span class:list={['grid h-4 w-4 shrink-0 translate-y-0.5 place-items-center rounded-full border text-[10px] leading-none', g.done ? 'border-transparent bg-ink text-paper dark:bg-stone-100 dark:text-night' : 'border-stone-400 dark:border-stone-500']} aria-label={g.done ? 'Done' : 'Not yet'}>{g.done ? '✓' : ''}</span>
                  <span class="min-w-0 flex-1 text-[15px] leading-snug">{g.goal}{!g.done && (g.analyses || g.missions?.length) && <span class="mono pl-2 text-[12px] text-stone-400 dark:text-stone-500">{g.analyses ? `${posts.length}/${g.analyses}` : `${g.missions!.filter((m) => m.done).length}/${g.missions!.length}`}</span>}</span>
                  <span class="mono shrink-0 text-[12px] text-stone-500 dark:text-stone-400">{g.done ? day(g.done).replace(/ \d+,/, '') : g.when}</span>
                  <span class="chev" aria-hidden="true"></span>
                </summary>
                <div class="goal-body">
                  {g.by && (
                    <div class="tl" data-set={g.set} data-by={g.by} data-done={g.done ?? ''}>
                      <span class="tl-track"><span class="tl-fill"></span></span>
                      <span class="tl-dot tl-start"></span>
                      <span class="tl-dot tl-end" title="Deadline"></span>
                      <span class="tl-dot tl-now" title={g.done ? 'Done' : 'Today'}></span>
                    </div>
                  )}
                  <dl class="facts">
                    <div><dt>Set</dt><dd>{day(g.set)}</dd></div>
                    <div><dt>Deadline</dt><dd>{g.by ? day(g.by) : g.when}</dd></div>
                    {g.done
                      ? <div><dt>Done</dt><dd>{day(g.done)}<span class="note">took {span(g.set, g.done)}</span></dd></div>
                      : <div><dt>Status</dt><dd>{g.analyses ? `${posts.length} of ${g.analyses} so far` : g.by ? 'In progress' : 'Ongoing'}<span class="note left" data-by={g.by ?? ''} data-set={g.set}></span></dd></div>}
                  </dl>
                  {g.missions?.length && (
                    <div class="missions">
                      <p class="missions-head">Missions <span class="mono">{g.missions.filter((m) => m.done).length}/{g.missions.length}</span></p>
                      <ul>
                        {g.missions.map((m) => (
                          <li class:list={['mission', { done: m.done }]}>
                            <span class="box" aria-label={m.done ? 'Done' : 'Not yet'}>{m.done ? '✓' : ''}</span>
                            <span class="flex-1">{m.task}</span>
                            {m.done && <span class="mono text-[11px] opacity-60">{day(m.done).replace(/, \d+$/, '')}</span>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            </li>
          ))}
          {!(list as typeof goals).length && <li class="py-2 text-[15px] text-stone-400">Nothing here yet.</li>}
        </ul>
      ))}
    </div>
  </div>

  {/* The Dip (Seth Godin): the curve from the book, with where I think I am on it. */}
  <section class="mt-14 grid items-center gap-6 sm:grid-cols-[1fr_1.35fr] sm:gap-10" aria-labelledby="dip">
    <div>
      <h2 id="dip" class="eyebrow">The Dip</h2>
      <p class="mt-3 text-[17px] leading-relaxed text-stone-700 dark:text-stone-300">
        From Seth Godin’s <span class="italic">The Dip</span> (2007): almost anything worth doing is fun at the start, then gets hard for a long time before it pays off. That long, hard middle is the Dip.
      </p>
      <p class="mt-3 text-[17px] leading-relaxed text-stone-700 dark:text-stone-300">
        His point is to push through the dips that lead somewhere and quit the rest on purpose, early. The dot is where I think I am.
      </p>
    </div>
    <svg viewBox="0 0 600 350" class="dip w-full" role="img" aria-label="The Dip: results rise at first, fall into a long dip as effort goes on, then climb steeply. A dot marks where I am now.">
      <path class="area" d="M44 300V200C44 150 124 128 174 138C234 150 264 246 334 256C414 266 484 212 584 48V300Z" />
      <path id="dip-curve" d="M44 200C44 150 124 128 174 138C234 150 264 246 334 256C414 266 484 212 584 48" fill="none" />
      {/* Axes, as in the book's drawing: the label sits in a gap in each arrow. */}
      <path class="axis" d="M20 300V176M20 44V16M8 30L20 10L32 30M44 330H222M380 330H570M556 318L580 330L556 342" />
      <text class="axis-label" transform="translate(26 110) rotate(-90)" text-anchor="middle">RESULTS</text>
      <text class="axis-label" x="301" y="337" text-anchor="middle">EFFORT</text>
      <text class="dip-label" x="400" y="160" text-anchor="middle">The Dip</text>
      <path class="axis thin" d="M390 172L344 238M344 238l2 -14M344 238l12 -7" />
      <g class="me" data-at={DIP_ME} style="opacity:0">
        <circle class="dot" r="5" />
        <text class="me-label" y="-14" text-anchor="middle">Now</text>
      </g>
    </svg>
  </section>

  {/* Life in weeks */}
  <section class="mt-14" aria-labelledby="weeks">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h2 id="weeks" class="eyebrow">Life in weeks</h2>
        <p class="mt-2 text-[15px] text-stone-600 dark:text-stone-400">Every square is a week, every row a year, up to {YEARS}.</p>
      </div>
      <p class="text-right">
        <span class="pct block text-5xl font-semibold leading-none tabular-nums">{pct.toFixed(1)}%</span>
        <span class="mono count mt-1 block text-[12px] text-stone-500 dark:text-stone-400">{n(lived)} of {n(total)} weeks</span>
      </p>
    </div>
    <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-stone-200 dark:bg-stone-800"><div class="bar h-full rounded-full bg-ink dark:bg-stone-100" style={`width:${pct}%`}></div></div>

    {/* What each colour means, right above the grid */}
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 text-[13px] text-stone-600 dark:text-stone-400">
      <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-[2px] bg-ink dark:bg-stone-100"></span>Meanwhile</li>
      {EVENTS.map((e) => <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-[2px]" style={`background:${e.color}`}></span>{e.label}</li>)}
      <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-[2px] border border-stone-300 dark:border-stone-600"></span>Still to come</li>
    </ul>
    <div class="mt-4 grid grid-cols-[1.6rem_1fr] gap-x-2">
      {/* Age every 10 years */}
      <div class="relative" aria-hidden="true">
        {Array.from({ length: YEARS / 10 + 1 }, (_, i) => <span class="mono absolute right-0 -translate-y-1/2 text-[10px] text-stone-400 dark:text-stone-500" style={`top:${((i * 10) / YEARS) * 100}%`}>{i * 10}</span>)}
      </div>
      <svg viewBox={`0 0 ${W} ${H}`} class="weeks h-auto w-full" role="img" aria-label={`Life in weeks: ${n(lived)} of ${n(total)} weeks lived, ${pct.toFixed(1)}%`}>
        <path class="future" d={squares(lived + 1, total)} />
        <path class="lived" d={squares(0, lived)} />
        {EVENTS.map((e) => <path class="event" data-from={e.from} data-to={e.to ?? ''} style={`fill:${e.color}`} d={squares(weekOf(e.from), Math.min(lived, weekOf(e.to ?? new Date())) + (e.to ? 1 : 0))} />)}
        <path class="now" d={squares(lived, lived + 1)} />
      </svg>
    </div>
  </section>
</Base>

<style>
  .tabs { display: flex; gap: 2px; padding: 2px; border-radius: 999px; background: rgb(120 113 108 / .12); }
  .tab { padding: 3px 10px; border-radius: 999px; font-size: 12px; color: inherit; opacity: .6; transition: background .15s, opacity .15s; }
  .tab .mono { font-size: 11px; opacity: .6; }
  .tab:hover { opacity: .9; }
  .tab[aria-selected='true'] { opacity: 1; background: var(--color-paper); box-shadow: 0 1px 2px rgb(0 0 0 / .08); }
  :global(.dark) .tab[aria-selected='true'] { background: #2a2826; }
  .goals { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .goals { max-height: 22rem; }
  .goal summary::-webkit-details-marker { display: none; }
  .goal summary:hover .chev, .goal[open] .chev { opacity: .9; }
  .chev { width: 7px; height: 7px; flex-shrink: 0; margin-left: -2px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-3px) rotate(45deg); opacity: .35; transition: transform .2s ease, opacity .2s ease; }
  .goal[open] .chev { transform: translateY(0) rotate(225deg); }
  .goal-body { padding: 0 4px 14px 28px; }
  .goal[open] .goal-body { animation: goal-in .25s ease; }
  @keyframes goal-in { from { opacity: 0; transform: translateY(-4px); } }
  .tl { position: relative; height: 12px; margin: 6px 6px 12px; }
  .tl-track { position: absolute; left: 0; right: 0; top: 5px; height: 2px; border-radius: 2px; background: rgb(120 113 108 / .25); overflow: hidden; }
  .tl-fill { position: absolute; left: 0; top: 0; bottom: 0; width: var(--now, 0%); background: currentColor; }
  .tl-dot { position: absolute; top: 2px; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: currentColor; }
  .tl-start { left: 0; }
  .tl-end { left: var(--by, 100%); background: transparent; border: 1.5px solid currentColor; }
  .tl-now { left: var(--now, 0%); width: 10px; height: 10px; top: 1px; margin-left: -5px; background: #e4572e; box-shadow: 0 0 0 3px rgb(228 87 46 / .2); }
  .facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 4px 28px; font-size: 13px; }
  .facts dt { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; opacity: .55; }
  .facts dd { font-weight: 500; }
  .missions { margin-top: 14px; padding-top: 10px; border-top: 1px dashed rgb(120 113 108 / .3); }
  .missions-head { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; opacity: .55; margin-bottom: 4px; }
  .missions-head .mono { letter-spacing: 0; padding-left: 4px; }
  .mission { display: flex; align-items: baseline; gap: 9px; padding: 3px 0; font-size: 13.5px; line-height: 1.35; }
  .mission .box { display: grid; place-items: center; width: 13px; height: 13px; flex-shrink: 0; transform: translateY(2px); border-radius: 3px; border: 1.5px solid rgb(120 113 108 / .6); font-size: 9px; line-height: 1; }
  .mission.done .box { background: #e4572e; border-color: #e4572e; color: #fff; }
  .mission.done > .flex-1 { opacity: .5; text-decoration: line-through; }
  .facts .note { display: block; font-weight: 400; font-size: 12px; opacity: .6; }
  @media (max-width: 480px) { .goal-body { padding-left: 0; } .facts { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { .goal[open] .goal-body, .chev { animation: none; transition: none; } }
  .progress { height: 6px; border-radius: 999px; background: rgb(120 113 108 / .18); overflow: hidden; }
  .progress span { display: block; height: 100%; border-radius: inherit; background: currentColor; }
  .card { border-radius: 14px; border: 1px solid #e7e5e4; padding: 1.25rem 1.4rem; transition: border-color .2s ease, transform .2s ease; }
  a.card:hover { border-color: #d6d3d1; transform: translateY(-2px); }
  :global(.dark) .card { border-color: #292524; }
  .weeks .lived { fill: var(--color-ink); }
  .weeks .future { fill: none; stroke: #d6d3d1; stroke-width: .8; }
  /* This week: same colour as the weeks already lived, blinking. */
  .weeks .now { fill: var(--color-ink); }
  :global(.dark) .weeks .now { fill: #f5f5f4; }
  .weeks .now { animation: beat 1.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  :global(.dark) .weeks .lived { fill: #f5f5f4; }
  :global(.dark) .weeks .future { stroke: #44403c; }
  @keyframes beat { 50% { opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .weeks .now { animation: none; } }
  .dip .area { fill: var(--color-ink); }
  .dip .axis { fill: none; stroke: var(--color-ink); stroke-width: 7; stroke-linejoin: round; }
  .dip .axis.thin { stroke-width: 2.5; stroke-linecap: round; }
  .dip .axis-label { font-size: 17px; letter-spacing: 3px; fill: var(--color-ink); }
  .dip .dip-label { font-size: 22px; font-weight: 700; fill: var(--color-ink); }
  .dip .dot { fill: var(--color-accent); stroke: var(--color-paper); stroke-width: 3; }
  .dip .me-label { font-size: 13px; font-weight: 500; fill: var(--color-accent); paint-order: stroke; stroke: var(--color-paper); stroke-width: 4px; }
  :global(.dark) .dip .area { fill: #f5f5f4; }
  :global(.dark) .dip .axis { stroke: #f5f5f4; }
  :global(.dark) .dip .axis-label, :global(.dark) .dip .dip-label { fill: #f5f5f4; }
  :global(.dark) .dip .dot, :global(.dark) .dip .me-label { stroke: #121211; }

</style>

<script>
  // Goals: the Open/Done tabs.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
    document.querySelectorAll<HTMLElement>('.goals').forEach((l) => { l.hidden = l.dataset.list !== t.dataset.tab; });
  }));

  // Goal timelines: from when it was set to the deadline (or to when it was done, if later), with the done day
  // or today marked; open goals also say how long is left.
  const DAY = 24 * 60 * 60 * 1000, today = Date.now();
  document.querySelectorAll<HTMLElement>('.tl').forEach((tl) => {
    const set = +new Date(tl.dataset.set!), by = +new Date(tl.dataset.by!), mark = tl.dataset.done ? +new Date(tl.dataset.done) : today;
    const end = Math.max(by, mark), at = (t: number) => `${Math.min(100, Math.max(0, ((t - set) / (end - set)) * 100))}%`;
    tl.style.setProperty('--by', at(by));
    tl.style.setProperty('--now', at(mark));
  });
  document.querySelectorAll<HTMLElement>('.note.left').forEach((el) => {
    const by = el.dataset.by;
    if (!by) {
      const d = Math.max(0, Math.floor((today - +new Date(el.dataset.set!)) / DAY));
      el.textContent = d < 1 ? 'since today' : `for ${d} day${d === 1 ? '' : 's'} so far`;
      return;
    }
    const d = Math.round((+new Date(by) - today) / DAY);
    el.textContent = d >= 0 ? `${d} day${d === 1 ? '' : 's'} left` : `${-d} days past the deadline`;
  });

  // Redraw with today's date (the page itself is only rebuilt when the site is).
  import { lifeWeeks, squares, weekOf } from '../personal';
  const { total, lived, pct } = lifeWeeks();
  const svg = document.querySelector<SVGSVGElement>('.weeks')!;
  svg.querySelector('.lived')!.setAttribute('d', squares(0, lived));
  svg.querySelector('.future')!.setAttribute('d', squares(lived + 1, total));
  svg.querySelector('.now')!.setAttribute('d', squares(lived, lived + 1));
  svg.querySelectorAll<SVGPathElement>('.event').forEach((p) => {
    const to = p.dataset.to;
    p.setAttribute('d', squares(weekOf(p.dataset.from!), Math.min(lived, weekOf(to || new Date())) + (to ? 1 : 0)));
  });
  const n = (x: number) => x.toLocaleString('en-US');
  document.querySelector('.pct')!.textContent = `${pct.toFixed(1)}%`;
  document.querySelector('.count')!.textContent = `${n(lived)} of ${n(total)} weeks`;
  document.querySelector<HTMLElement>('.bar')!.style.width = `${pct}%`;
  // Put "Now" on the Dip curve at its fraction of the way along the effort axis.
  const curve = document.querySelector<SVGPathElement>('#dip-curve')!, me = document.querySelector<SVGGElement>('.dip .me')!;
  const x0 = 44, x1 = 584, target = x0 + (x1 - x0) * +me.dataset.at!, len = curve.getTotalLength();
  let lo = 0, hi = len;
  for (let i = 0; i < 30; i++) { const mid = (lo + hi) / 2; if (curve.getPointAtLength(mid).x < target) lo = mid; else hi = mid; }
  const at = curve.getPointAtLength(lo);
  me.setAttribute('transform', `translate(${at.x.toFixed(1)} ${at.y.toFixed(1)})`);
  me.style.opacity = '1';
  svg.setAttribute('aria-label', `Life in weeks: ${n(lived)} of ${n(total)} weeks lived, ${pct.toFixed(1)}%`);
</script>
