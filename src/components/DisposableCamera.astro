---
// A disposable camera in a given look (src/trips.ts): the plain one on /resources (the way into Photos), and
// one per trip on /resources/photos. The lens is at (350, 160) in the 520×300 drawing; .flash-window is the
// flash, for animations.
import type { CameraLook } from '../trips';
interface Props { look: CameraLook; exp: number; class?: string; id?: string }
const { look, exp, class: cls = 'w-full', id = 'lens-clip' } = Astro.props;
---
<svg viewBox="0 0 520 300" class={cls} aria-hidden="true">
  <defs><clipPath id={id}><circle cx="350" cy="160" r="64" /></clipPath></defs>
  <rect x="58" y="34" width="70" height="26" rx="6" fill="#26262a" />
  <rect x="402" y="40" width="44" height="20" rx="4" fill="#d94f3d" />
  <rect x="20" y="56" width="480" height="224" rx="26" fill={look.body} />
  {/* Paper wrap */}
  <rect x="20" y="126" width="480" height="122" fill={look.wrap} />
  <rect x="20" y="126" width="480" height="10" fill={look.stripe} /><rect x="20" y="238" width="480" height="10" fill={look.stripe} />
  <text x="46" y="176" fill={look.ink} font-size="30" font-weight="800" letter-spacing="1">{look.brand}</text>
  <text x="46" y="204" fill={look.ink} font-size="13" font-weight="600" letter-spacing="3">{look.sub ? `${look.sub} · ` : ""}{exp} EXP</text>
  <text x="46" y="226" fill={look.ink} font-size="11" letter-spacing="2" opacity=".7">{look.sub === "SINGLE USE" ? "ISO 400 · FLASH" : "SINGLE USE · ISO 400 · FLASH"}</text>
  {/* Viewfinder, flash, wind wheel */}
  <rect x="46" y="74" width="62" height="38" rx="6" fill="#3b3b40" /><rect x="54" y="81" width="46" height="24" rx="3" fill="#6f8aa1" opacity=".7" />
  <rect class="flash-window" x="200" y="72" width="118" height="42" rx="6" fill="#e9e6df" />
  <path d="M206 80h106M206 88h106M206 96h106M206 104h106" stroke="#c9c4b8" stroke-width="2" />
  <g transform="translate(470 64)"><rect x="-12" y="-22" width="24" height="40" rx="5" fill="#2b2b30" />{[0, 1, 2, 3, 4, 5, 6].map((i) => <rect x="-12" y={-19 + i * 5} width="24" height="2" fill="#141416" />)}</g>
  {/* Lens */}
  <circle cx="350" cy="160" r="86" fill="#141416" />
  <circle cx="350" cy="160" r="72" fill="#2b2b30" />
  <circle cx="350" cy="160" r="64" fill="#0b0c10" />
  <g clip-path={`url(#${id})`}><circle cx="330" cy="140" r="40" fill="#1b2a3a" opacity=".8" /><circle cx="326" cy="134" r="12" fill="#fff" opacity=".22" /><circle cx="372" cy="186" r="6" fill="#fff" opacity=".12" /></g>
  <circle cx="350" cy="160" r="86" fill="none" stroke="#3b3b40" stroke-width="3" />
</svg>
