# Cache rules for Cloudflare static assets.
# Files in /_astro have a content hash in their name, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images rarely change; keep them a week (re-run `npm run images` and redeploy to update).
/img/*
  Cache-Control: public, max-age=604800
